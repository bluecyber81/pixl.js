static bool tag_helper_valid_default_slot(void) { return true; }
static void *mui_mem_malloc(size_t n) { void *p = malloc(n); CHECK(p); outstanding++; return p; }
static void mui_mem_free(void *p) { if (p) { CHECK(outstanding > 0); outstanding--; free(p); } }
static int app_timer_create(int *t, int mode, void (*cb)(void *)) { *t = 1; return 0; }
static int app_timer_start(int t, unsigned ticks, void *arg) { return 0; }
static int app_timer_stop(int t) { return 0; }
