/* Isolate the array lookup, animation scheduler and sample data. All row
 * geometry, fonts, clipping, focus and scrollbar rendering below use U8g2. */
#define LIST_ANIM_SCROLL 1
#define LIST_ANIM_FOCUS 0
typedef struct { uint16_t icon; string_t text, sub_text; } mui_list_item_t;
typedef struct {
    mui_list_item_t *rows;
    size_t count;
} window_items_t;
typedef struct {
    window_items_t items;
    uint16_t focus_index, scroll_offset;
    uint8_t item_gap, anim_type, canvas_height, canvas_width, first_draw;
    int16_t anim_value, text_offset;
} mui_list_view_t;
static size_t row_visits;
static mui_list_item_t *window_item(window_items_t items, size_t index) {
    CHECK(index < items.count);
    ++row_visits;
    return &items.rows[index];
}
#define mui_list_item_array_get window_item
#define mui_list_item_array_size(a) ((a).count)
static void mui_list_view_start_text_anim(mui_list_view_t *view) { (void)view; }
static void mui_list_view_start_gap_anim(mui_list_view_t *view) { (void)view; }
/*ACTUAL_LIST_FUNCTIONS*/

/* Reference: visit every row and use the original inclusive clipping rule. */
static void draw_all_rows(mui_view_t *view, mui_canvas_t *canvas) {
    mui_list_view_t *list = view->user_data;
    int32_t offset = list->scroll_offset;
    if (list->anim_type == LIST_ANIM_SCROLL) offset += list->anim_value;
    for (size_t i = 0; i < list->items.count; ++i) {
        mui_list_item_t *item = window_item(list->items, i);
        int32_t row = (int32_t)i * LIST_ITEM_HEIGHT - offset;
        if (row < -LIST_ITEM_HEIGHT || row > canvas->height) continue;
        int32_t y = (int32_t)i * list->item_gap - offset;
        mui_canvas_set_font(canvas, u8g2_font_siji_t_6x10);
        mui_canvas_draw_glyph(canvas, 0, y + 10, item->icon);
        mui_canvas_set_font(canvas, u8g2_font_wqy12_t_gb2312a);
        mui_list_view_draw_row_text(canvas, y, i == list->focus_index ? list->text_offset : 0,
                                    string_get_cstr(item->text), string_get_cstr(item->sub_text));
    }
    int32_t y = list->focus_index * LIST_ITEM_HEIGHT - offset;
    if (list->anim_type == LIST_ANIM_FOCUS) y += list->anim_value;
    y = LV_MIN(LV_MAX(y, 0), canvas->height - LIST_ITEM_HEIGHT);
    mui_canvas_set_draw_color(canvas, 2);
    mui_canvas_draw_box(canvas, 0, y, canvas->width, 12);
    mui_canvas_set_draw_color(canvas, 1);
    mui_element_scrollbar(canvas, list->focus_index, list->items.count);
}

static void compare_list_window(mui_canvas_t *canvas, uint8_t *buffer, const char *dir) {
    enum { MAX_ROWS = 1081 };
    mui_list_item_t *items = calloc(MAX_ROWS, sizeof(*items));
    CHECK(items);
    for (unsigned i = 0; i < MAX_ROWS; ++i) {
        char label[64];
        snprintf(label, sizeof(label), "Figur %u mit langem Namen", i);
        string_init_set_str(items[i].text, label);
        snprintf(label, sizeof(label), "%u%%", i % 101);
        string_init_set_str(items[i].sub_text, label);
        items[i].icon = 0xe140 + i % 32;
    }
    mui_list_view_t list = {.items = {.rows = items}, .first_draw = 1};
    mui_view_t view = {.user_data = &list};
    const unsigned counts[] = {0, 1, 4, 5, 17, MAX_ROWS};
    const int anim_offsets[] = {-26, -13, -12, -1, 0, 1, 12, 13, 26};
    const int gaps[] = {1, 8, LIST_ITEM_HEIGHT};
    unsigned cases = 0, max_visits = 0;
    uint8_t expected[1024];
    for (size_t n = 0; n < sizeof(counts)/sizeof(*counts); ++n) {
        unsigned count = counts[n];
        list.items.count = count;
        unsigned offsets[] = {0, 1, 12, 13, 14, count*13/2, count ? (count-1)*13 : 0};
        for (size_t pos = 0; pos < sizeof(offsets)/sizeof(*offsets); ++pos) {
            list.scroll_offset = offsets[pos];
            list.focus_index = count ? LV_MIN(count - 1, list.scroll_offset / 13 + 1) : 0;
            list.text_offset = pos % 2 ? -17 : 0;
            for (unsigned height = 52; height <= 64; height += 12) {
                mui_canvas_set_frame(canvas, 0, 64-height, 128, height);
                for (unsigned mode = 0; mode <= 1; ++mode) {
                    list.anim_type = mode;
                    for (size_t a = 0; a < sizeof(anim_offsets)/sizeof(*anim_offsets); ++a) {
                        list.anim_value = anim_offsets[a];
                        for (size_t gap = 0; gap < sizeof(gaps)/sizeof(*gaps); ++gap) {
                            list.item_gap = gaps[gap];
                            memset(buffer, 0, 1024);
                            row_visits = 0;
                            draw_all_rows(&view, canvas);
                            CHECK(row_visits == count);
                            memcpy(expected, buffer, 1024);
                            memset(buffer, 0, 1024);
                            row_visits = 0;
                            mui_list_view_on_draw(&view, canvas);
                            CHECK(memcmp(expected, buffer, 1024) == 0);
                            CHECK(row_visits <= 6);
                            if (count == MAX_ROWS && row_visits > max_visits) max_visits = row_visits;
                            ++cases;
                        }
                    }
                }
            }
        }
    }
    CHECK(max_visits == 6);
    printf("PASS %u pixel-identical list frames; %u instead of %u row visits at most for the long list\n",
           cases, max_visits, MAX_ROWS);
    if (dir) {
        const char *titles[] = {"Version", "Sprache", "Speicher", "Kontrast", "Beleuchtung"};
        const char *values[] = {"2.22.0-DE3.79", "Deutsch", "46%", "100%", "70%"};
        const uint16_t icons[] = {0xe1c7, 0xe26d, 0xe146, 0xe1c8, 0xe1c8};
        for (unsigned i = 0; i < 5; ++i) {
            string_set_str(items[i].text, titles[i]);
            string_set_str(items[i].sub_text, values[i]);
            items[i].icon = icons[i];
        }
        list.items.count = 5;
        list.focus_index = 3;
        list.scroll_offset = 0;
        list.item_gap = LIST_ITEM_HEIGHT;
        list.anim_value = list.text_offset = 0;
        memset(buffer, 0, 1024);
        mui_canvas_set_frame(canvas, 0, 0, 128, 64);
        mui_list_view_on_draw(&view, canvas);
        save_frame(dir, "lcd-kontrast-100", buffer);
    }
    for (unsigned i = 0; i < MAX_ROWS; ++i) {
        string_clear(items[i].text);
        string_clear(items[i].sub_text);
    }
    free(items);
}
