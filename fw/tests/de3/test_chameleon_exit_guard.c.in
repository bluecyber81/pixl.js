static void mui_canvas_draw_utf8(mui_canvas_t *c,unsigned x,unsigned y,const char *text) {assert(x==0&&y<=64&&text);if(y==27)detail_line=text;drawn++;}
static void *mini_app_launcher(void) {return current;}
static void mini_app_launcher_exit(void *launcher) {assert(launcher==current);app_chameleon_on_kill(current);}
