static int32_t settings_save(void) {
    assert(!sense_active&&!irq_enabled);settings_writes++;
    if (!settings_error) persisted_settings=settings;
    return settings_error;
}
static bool tag_helper_valid_default_slot(void) {return settings.chameleon_default_slot_index!=INVALID_SLOT_INDEX;}
bool tag_emulation_slot_is_enabled(uint8_t slot, tag_sense_type_t sense) {assert(slot<TAG_MAX_SLOT_NUM);return slotConfig.slots[slot].enabled_hf;}
static void hal_nfc_set_nrfx_irq_enable(uint8_t enable) {irq_enabled=enable;}
static void tag_emulation_sense_switch_all(bool enable) {sense_active=enable;}
static unsigned path_number(const char *path) {
    if (!strcmp(path,"/chameleon/slots/config.bin")) return 2;
    if (!strcmp(path,"/chameleon/slots/00.bin")) return 0;
    assert(!strcmp(path,"/chameleon/slots/01.bin"));return 1;
}
static uint8_t *path_bytes(unsigned number) {return number==2?config_file:files[number];}
static unsigned path_size(unsigned number) {return number==2?config_size:file_size;}
static bool backend_mounted(void) {return true;}
static int32_t backend_write(const char *path,void *input,size_t n) {
    assert(!sense_active&&!irq_enabled);
    unsigned number=path_number(path);
    if(number==2) {config_writes++;if(config_write_error)return config_write_error;assert(n<=sizeof(config_file));config_size=n;}
    else {data_writes++;if(data_write_error)return data_write_error;assert(n<=sizeof(files[0]));}
    memcpy(path_bytes(number),input,n);return (int32_t)n;
}
static int32_t backend_read_data(const char *path,void *output,size_t n) {
    unsigned number=path_number(path);loads++;
    if(n>path_size(number))n=path_size(number);
    memcpy(output,path_bytes(number),n);return (int32_t)n;
}
static int32_t backend_stat(const char *path,vfs_obj_t *obj) {
    unsigned number=path_number(path);memset(obj,0,sizeof(*obj));obj->type=VFS_TYPE_REG;obj->size=path_size(number);return VFS_OK;
}
static struct {unsigned number,offset;} read_handle;
static int32_t backend_open(const char *path,vfs_file_t *fd,uint32_t flags) {
    assert(flags==VFS_MODE_READONLY);read_handle.number=path_number(path);read_handle.offset=0;fd->handle=&read_handle;if(read_handle.number<2)card_opens++;return VFS_OK;
}
static int32_t backend_read(vfs_file_t *fd,void *output,size_t n) {
    assert(fd->handle==&read_handle);if(fail_compare_read)return VFS_ERR_FAIL;
    if(n>path_size(read_handle.number)-read_handle.offset)n=path_size(read_handle.number)-read_handle.offset;
    memcpy(output,path_bytes(read_handle.number)+read_handle.offset,n);read_handle.offset+=n;return (int32_t)n;
}
static int32_t backend_close(vfs_file_t *fd) {fd->handle=NULL;return VFS_OK;}
static vfs_driver_t driver={.mounted=backend_mounted,.stat_file=backend_stat,.open_file=backend_open,
    .read_file=backend_read,.close_file=backend_close,.abort_file=backend_close,
    .read_file_data=backend_read_data,.write_file_data=backend_write};
vfs_driver_t *vfs_get_default_driver(void) {return &driver;}
typedef struct {uint16_t id,key;} fds_slot_record_map_t;
static void get_fds_map_by_slot_sense_type_for_dump(uint8_t slot,tag_sense_type_t type,fds_slot_record_map_t *map) {
    assert(slot<2&&type==TAG_SENSE_HF);map->id=FDS_SLOT_TAG_DUMP_FILE_ID_BASE+slot;map->key=type;
}
tag_data_buffer_t *get_buffer_by_tag_type(tag_specific_type_t type) {return &buffer;}
tag_sense_type_t get_sense_type_from_tag_type(tag_specific_type_t type) {return type==TAG_TYPE_MIFARE_Mini?TAG_SENSE_HF:TAG_SENSE_NO;}
static int mock_load_callback(tag_specific_type_t type,tag_data_buffer_t *b) {
    int size=get_information_size_by_tag_type(type);if(size>b->length)return 0;
    m_tag_information=(void*)b->buffer;m_tag_type=type;return size;
}
static tag_datas_loadcb_t get_data_loadcb_from_tag_type(tag_specific_type_t type) {return mock_load_callback;}
static tag_datas_savecb_t get_data_savecb_from_tag_type(tag_specific_type_t type) {return nfc_tag_mf1_data_savecb;}
static int32_t tag_emulation_load_config(void) {
    if(fail_config_load)return -1;
    memset(&slotConfig,0,sizeof(slotConfig));memcpy(&slotConfig,config_file,config_size);
    calc_14a_crc_lut((uint8_t*)&slotConfig,sizeof(slotConfig),(uint8_t*)&m_slot_config_crc);return config_size;
}
static bool fds_config_file_exists(void) {return config_size!=0;}
