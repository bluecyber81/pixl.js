/* The original launcher always called kill_cb after only the unrelated NTAG
 * guard. The baseline adapter reproduces that decision, not a patched saver. */
static bool prepare(mini_app_inst_t *inst,mini_app_exit_reason_t reason) {
#if HAS_EXIT_GUARD
    return app_chameleon_info.prepare_exit_cb(inst,reason);
#else
    app_chameleon_info.kill_cb(inst);return true;
#endif
}
static void cancel(mini_app_inst_t *inst) {
#if HAS_EXIT_GUARD
    app_chameleon_info.cancel_exit_cb(inst);
#else
    (void)inst;
#endif
}
static void retry_input(mini_app_inst_t *inst,input_type_t type) {
#if HAS_EXIT_GUARD
    app_chameleon_t *app=inst->p_handle;mui_input_event_t event={INPUT_KEY_CENTER,type};
    assert(app->p_view_dispatcher->p_active_view==&app->save_error_view);
    app->save_error_view.input_cb(&app->save_error_view,&event);
#else
    (void)inst;(void)type;
#endif
}
static uint8_t disk_byte(unsigned slot) {return ((nfc_tag_mf1_information_t*)files[slot])->memory[4][0];}
static void setup(mini_app_inst_t *inst,uint8_t def,nfc_tag_mf1_write_mode_t mode) {
    assert(!live);memset(inst,0,sizeof(*inst));current=inst;
    settings=(settings_data_t){def,8};persisted_settings=settings;memset(&slotConfig,0,sizeof(slotConfig));
    slotConfig.version=TAG_SLOT_CONFIG_CURRENT_VERSION;slotConfig.active_slot=0;
    for(unsigned i=0;i<2;i++){slotConfig.slots[i].enabled_hf=1;slotConfig.slots[i].tag_hf=TAG_TYPE_MIFARE_Mini;}
    config_size=TAG_SLOT_CONFIG_SIZE(settings.chameleon_slot_num);memcpy(config_file,&slotConfig,config_size);
    memset(data,0,sizeof(data));m_tag_information=(void*)data;m_tag_type=TAG_TYPE_MIFARE_Mini;
    file_size=get_information_size_by_tag_type(m_tag_type);
    for(unsigned i=0;i<2;i++){
        m_tag_information->config.mode_block_write=mode;m_tag_information->memory[4][0]=i?0x33:0x11;
        memcpy(files[i],data,file_size);
    }
    memset(data,0,sizeof(data));data_write_error=config_write_error=settings_error=0;
    fail_compare_read=fail_config_load=false;sense_active=irq_enabled=false;
    data_writes=config_writes=settings_writes=loads=allocations=scenes_exited=drawn=updates=0;
    app_chameleon_info.run_cb(inst);assert(inst->p_handle&&live==9&&m_tag_data_loaded&&sense_active&&irq_enabled);
    assert(m_tag_information->memory[4][0]==0x11&&tag_emulation_get_slot()==0);
}
static void cleanup_success(mini_app_inst_t *inst) {
    assert(prepare(inst,MINI_APP_EXIT_SWITCH));
    unsigned writes=data_writes+config_writes+settings_writes;
    app_chameleon_info.kill_cb(inst);assert(!inst->p_handle&&!live);
    assert(data_writes+config_writes+settings_writes==writes); /* cleanup cannot publish */
}
static void check_error_keeps_owner(mini_app_inst_t *inst,void *owner,unsigned before_alloc) {
    assert(inst->p_handle==owner&&live==9&&((app_chameleon_t*)owner)->initialized);
    assert(!sense_active&&!irq_enabled&&!scenes_exited&&allocations==before_alloc);
    assert(tag_emulation_get_slot()==0);
#if HAS_EXIT_GUARD
    app_chameleon_t *app=owner;assert(app->p_view_dispatcher->p_active_view==&app->save_error_view);
    mui_canvas_t canvas={0};app->save_error_view.draw_cb(&app->save_error_view,&canvas);assert(drawn%4==0);
#endif
}
static void test_error_retry(unsigned fault,mini_app_exit_reason_t reason) {
    mini_app_inst_t inst;setup(&inst,INVALID_SLOT_INDEX,NFC_TAG_MF1_WRITE_NORMAL);
    void *owner=inst.p_handle;unsigned before_alloc=allocations;uint16_t before_crc=data_crc;
    if(fault!=3)m_tag_information->memory[4][0]=0x22;
    if(fault==0)data_write_error=VFS_ERR_NOSPC;
    if(fault==1)data_write_error=VFS_ERR_FAIL;
    if(fault==2){slotConfig.slots[1].enabled_hf=0;config_write_error=VFS_ERR_NOSPC;}
    if(fault==3)fail_compare_read=true;
    if(fault==4)settings_error=-91;
    if(fault==5)settings_error=8;
    assert(!prepare(&inst,reason)); /* Same assertion deliberately fails on DE3.57. */
    check_error_keeps_owner(&inst,owner,before_alloc);
    assert(m_tag_information->memory[4][0]==(fault==3?0x11:0x22));
    if(fault<2){assert(data_crc==before_crc&&disk_byte(0)==0x11&&!config_writes&&!settings_writes);}
    else if(fault==2)assert(disk_byte(0)==0x22&&!settings_writes);
    /* A second failure must not replace the remembered view or the RAM copy. */
    retry_input(&inst,INPUT_TYPE_SHORT);check_error_keeps_owner(&inst,owner,before_alloc);
    data_write_error=config_write_error=settings_error=0;fail_compare_read=false;
    retry_input(&inst,INPUT_TYPE_SHORT);
    assert(inst.p_handle==owner&&sense_active&&irq_enabled&&live==9);
    assert(disk_byte(0)==(fault==3?0x11:0x22));
    cleanup_success(&inst);
    app_chameleon_info.run_cb(&inst);assert(m_tag_information->memory[4][0]==(fault==3?0x11:0x22));
    cleanup_success(&inst);cases++;
}
static void test_default_and_cancel(uint8_t def,bool disabled,nfc_tag_mf1_write_mode_t mode) {
    mini_app_inst_t inst;setup(&inst,def,mode);app_chameleon_t *app=inst.p_handle;
    if(disabled)slotConfig.slots[1].enabled_hf=0;
    m_tag_information->memory[4][0]=0x22;
    uint8_t before[4500];memcpy(before,data,sizeof(before));unsigned before_loads=loads;
    assert(prepare(&inst,MINI_APP_EXIT_RESET));
    assert(!sense_active&&!irq_enabled&&inst.p_handle==app&&loads==before_loads);
    assert(!memcmp(data,before,sizeof(before))&&tag_emulation_get_slot()==0);
    uint8_t expected=def==1&&!disabled?1:0;
    assert(((tag_slot_config_t*)config_file)->active_slot==expected);
    uint8_t expected_default=(def==0||(def==1&&!disabled))?def:INVALID_SLOT_INDEX;
    assert(settings.chameleon_default_slot_index==expected_default);
    assert(persisted_settings.chameleon_default_slot_index==expected_default);
    assert(tag_helper_valid_default_slot()==(expected_default!=INVALID_SLOT_INDEX));
    assert(disk_byte(0)==(mode==NFC_TAG_MF1_WRITE_SHADOW?0x11:0x22));
    unsigned writes=data_writes+config_writes+settings_writes;
    assert(prepare(&inst,MINI_APP_EXIT_RESET)&&writes==data_writes+config_writes+settings_writes);
    cancel(&inst);assert(sense_active&&irq_enabled&&!memcmp(data,before,sizeof(before))&&loads==before_loads);
    /* Restoring the RAM selection must not falsify the persisted config CRC. */
    tag_emulation_sense_end();hal_nfc_set_nrfx_irq_enable(false);
#if HAS_EXIT_GUARD
    assert(tag_emulation_save());
#else
    tag_emulation_save();
#endif
    assert(((tag_slot_config_t*)config_file)->active_slot==0);
    hal_nfc_set_nrfx_irq_enable(true);tag_emulation_sense_run();
    cleanup_success(&inst);cases++;
}
static void test_default_config_retry(void) {
    mini_app_inst_t inst;setup(&inst,1,NFC_TAG_MF1_WRITE_NORMAL);
    m_tag_information->memory[4][0]=0x22;config_write_error=VFS_ERR_FAIL;
    unsigned before_loads=loads;void *owner=inst.p_handle;
    assert(!prepare(&inst,MINI_APP_EXIT_SLEEP));
    assert(inst.p_handle==owner&&loads==before_loads&&tag_emulation_get_slot()==0&&m_tag_information->memory[4][0]==0x22);
    assert(disk_byte(0)==0x22&&((tag_slot_config_t*)config_file)->active_slot==0);
    config_write_error=0;assert(prepare(&inst,MINI_APP_EXIT_SLEEP));
    assert(loads==before_loads&&((tag_slot_config_t*)config_file)->active_slot==1&&tag_emulation_get_slot()==0);
    cancel(&inst);assert(sense_active&&irq_enabled&&m_tag_information->memory[4][0]==0x22);
    cleanup_success(&inst);
    app_chameleon_info.run_cb(&inst);assert(tag_emulation_get_slot()==1&&m_tag_information->memory[4][0]==0x33);
    cleanup_success(&inst);cases++;
}
static void test_invalid_default_failure_rollback(uint8_t def,unsigned fault) {
    mini_app_inst_t inst;setup(&inst,def,NFC_TAG_MF1_WRITE_NORMAL);
    slotConfig.slots[1].enabled_hf=0; /* invalid default 1, and a dirty config */
    m_tag_information->memory[4][0]=0x22;
    if(fault==0)data_write_error=VFS_ERR_NOSPC;
    if(fault==1)config_write_error=VFS_ERR_NOSPC;
    if(fault==2)settings_error=-1;
    unsigned before_loads=loads;void *owner=inst.p_handle;
    assert(!prepare(&inst,MINI_APP_EXIT_RESET));
    assert(inst.p_handle==owner&&loads==before_loads&&!sense_active&&!irq_enabled);
    assert(settings.chameleon_default_slot_index==def&&persisted_settings.chameleon_default_slot_index==def);
    assert(tag_emulation_get_slot()==0&&m_tag_information->memory[4][0]==0x22);
    data_write_error=config_write_error=settings_error=0;
    assert(prepare(&inst,MINI_APP_EXIT_RESET));
    assert(settings.chameleon_default_slot_index==INVALID_SLOT_INDEX);
    assert(persisted_settings.chameleon_default_slot_index==INVALID_SLOT_INDEX&&!tag_helper_valid_default_slot());
    assert(loads==before_loads&&disk_byte(0)==0x22);
    cancel(&inst);assert(sense_active&&irq_enabled&&m_tag_information->memory[4][0]==0x22);
    cleanup_success(&inst);cases++;
}
static void test_shadow_request_retry(void) {
    mini_app_inst_t inst;setup(&inst,1,NFC_TAG_MF1_WRITE_NORMAL);
    m_tag_information->config.mode_block_write=NFC_TAG_MF1_WRITE_SHADOW_REQ;
    m_tag_information->memory[4][0]=0x22;uint16_t old_crc=data_crc;
    data_write_error=VFS_ERR_NOSPC;
    assert(!prepare(&inst,MINI_APP_EXIT_RESET));
    assert(m_tag_information->config.mode_block_write==NFC_TAG_MF1_WRITE_SHADOW_REQ&&data_crc==old_crc&&disk_byte(0)==0x11);
    data_write_error=0;config_write_error=VFS_ERR_NOSPC;
    assert(!prepare(&inst,MINI_APP_EXIT_RESET));
    assert(m_tag_information->config.mode_block_write==NFC_TAG_MF1_WRITE_SHADOW&&disk_byte(0)==0x22);
    unsigned saved=data_writes;config_write_error=0;
    assert(prepare(&inst,MINI_APP_EXIT_RESET)&&data_writes==saved);cancel(&inst);
    m_tag_information->memory[4][0]=0x44;cleanup_success(&inst);
    assert(disk_byte(0)==0x22);cases++;
}
static void existing_dialog_cb(mui_msg_box_event_t event,mui_msg_box_t *box) {(void)event;(void)box;}
static void test_cancel_dialog_and_menu_cleanup(void) {
    mini_app_inst_t inst;setup(&inst,INVALID_SLOT_INDEX,NFC_TAG_MF1_WRITE_NORMAL);
    app_chameleon_t *app=inst.p_handle;
    tag_emulation_sense_end();hal_nfc_set_nrfx_irq_enable(false);
    app->p_scene_dispatcher->scene=CHAMELEON_SCENE_MENU;
    app->p_msg_box->event_cb=existing_dialog_cb;app->p_msg_box->message="original dialog";
    mui_view_dispatcher_switch_to_view(app->p_view_dispatcher,CHAMELEON_VIEW_ID_MSG_BOX);
    m_tag_information->memory[4][0]=0x22;data_write_error=VFS_ERR_NOSPC;
    assert(!prepare(&inst,MINI_APP_EXIT_SWITCH));retry_input(&inst,INPUT_TYPE_LONG);
    assert(!sense_active&&!irq_enabled&&m_tag_information->memory[4][0]==0x22&&disk_byte(0)==0x11);
    assert(app->p_msg_box->event_cb==existing_dialog_cb&&!strcmp(app->p_msg_box->message,"original dialog"));
    assert(app->p_view_dispatcher->p_active_view==mui_msg_box_get_view(app->p_msg_box));
    data_write_error=0;assert(prepare(&inst,MINI_APP_EXIT_SWITCH));
    unsigned writes=data_writes+config_writes+settings_writes;
    /* Cleanup must not re-save even if the backend starts failing now. */
    data_write_error=config_write_error=VFS_ERR_NOSPC;settings_error=-1;
    app_chameleon_info.kill_cb(&inst);assert(!live&&!inst.p_handle&&writes==data_writes+config_writes+settings_writes);cases++;
}
static void test_failed_init_can_leave(void) {
    mini_app_inst_t inst;setup(&inst,INVALID_SLOT_INDEX,NFC_TAG_MF1_WRITE_NORMAL);cleanup_success(&inst);
    fail_config_load=true;app_chameleon_info.run_cb(&inst);app_chameleon_t *app=inst.p_handle;
    assert(app&&!app->initialized&&!sense_active&&!irq_enabled);
    unsigned writes=data_writes+config_writes+settings_writes;
    assert(prepare(&inst,MINI_APP_EXIT_SWITCH));app_chameleon_info.kill_cb(&inst);
    assert(!live&&!inst.p_handle&&writes==data_writes+config_writes+settings_writes);cases++;
}
#if HAS_COUNT_RETRY
static void test_count_change_retry_and_resume(bool go_back, bool fail_card_first) {
    mini_app_inst_t inst;
    setup(&inst,INVALID_SLOT_INDEX,NFC_TAG_MF1_WRITE_NORMAL);
    app_chameleon_t *app=inst.p_handle;
    tag_emulation_sense_end();
    hal_nfc_set_nrfx_irq_enable(false);
    mui_scene_dispatcher_next_scene(app->p_scene_dispatcher,CHAMELEON_SCENE_MENU);
    mui_list_item_t item={ICON_DATA,(void *)(uintptr_t)20};
    mui_canvas_t canvas={0};
    unsigned before_alloc=allocations;
    m_tag_information->memory[4][0]=0x22;
    if(fail_card_first) {
        data_write_error=VFS_ERR_NOSPC;
        chameleon_scene_menu_card_slot_num_select_on_event(0,app->p_list_view,&item);
        app->save_error_view.draw_cb(&app->save_error_view,&canvas);
        assert(!strcmp(detail_line,"DE3_SAVE_RAM_ONLY")&&settings.chameleon_slot_num==8);
        retry_input(&inst,INPUT_TYPE_LONG);
        data_write_error=0;
    }
    config_write_error=VFS_ERR_NOSPC;
    chameleon_scene_menu_card_slot_num_select_on_event(0,app->p_list_view,&item);
    app->save_error_view.draw_cb(&app->save_error_view,&canvas);
    assert(!strcmp(detail_line,"DE3_SLOT_COUNT_PENDING")&&disk_byte(0)==0x22);
    assert(settings.chameleon_slot_num==20&&persisted_settings.chameleon_slot_num==8);
    assert(config_size==TAG_SLOT_CONFIG_SIZE(8)&&!settings_writes);
    unsigned opens=card_opens, writes=data_writes;
    config_write_error=0;settings_error=8;
    retry_input(&inst,INPUT_TYPE_SHORT);
    assert(app->p_view_dispatcher->p_active_view==&app->save_error_view);
    assert(app->retry_slot_count&&config_size==TAG_SLOT_CONFIG_SIZE(20));
    assert(settings_writes==1&&persisted_settings.chameleon_slot_num==8);
    assert(card_opens==opens&&data_writes==writes);
    settings_error=0;
    if(go_back) {
        retry_input(&inst,INPUT_TYPE_LONG);
        assert(app->p_view_dispatcher->p_active_view==mui_list_view_get_view(app->p_list_view));
        assert(!app->retry_slot_count&&settings.chameleon_slot_num==20);
        assert(settings_writes==1&&!sense_active&&!irq_enabled);
        m_tag_information->memory[4][0]=0x44; /* new edit after returning */
        assert(app_chameleon_save(app));
        assert(disk_byte(0)==0x44&&data_writes==writes+1);
    } else {
        retry_input(&inst,INPUT_TYPE_SHORT);
        assert(!app->retry_slot_count&&card_opens==opens&&data_writes==writes);
    }
    assert(settings_writes==2&&persisted_settings.chameleon_slot_num==20);
    assert(config_size==TAG_SLOT_CONFIG_SIZE(20)&&allocations==before_alloc);
    cleanup_success(&inst);cases++;
}
#endif
int main(void) {
#if HAS_COUNT_RETRY
    for(unsigned i=0;i<4;i++)test_count_change_retry_and_resume(i&1,i&2);
#endif
    mini_app_exit_reason_t reasons[]={MINI_APP_EXIT_SWITCH,MINI_APP_EXIT_SLEEP,MINI_APP_EXIT_RESET};
    for(unsigned r=0;r<3;r++)for(unsigned fault=0;fault<6;fault++)test_error_retry(fault,reasons[r]);
    uint8_t defaults[]={INVALID_SLOT_INDEX,0,1,TAG_MAX_SLOT_NUM,8};
    for(unsigned mode=0;mode<2;mode++)for(unsigned i=0;i<sizeof(defaults);i++)
        test_default_and_cancel(defaults[i],false,mode?NFC_TAG_MF1_WRITE_SHADOW:NFC_TAG_MF1_WRITE_NORMAL);
    test_default_and_cancel(1,true,NFC_TAG_MF1_WRITE_NORMAL);
    test_default_and_cancel(1,true,NFC_TAG_MF1_WRITE_SHADOW);
    uint8_t invalid_defaults[]={1,8,TAG_MAX_SLOT_NUM};
    for(unsigned d=0;d<sizeof(invalid_defaults);d++)for(unsigned fault=0;fault<3;fault++)
        test_invalid_default_failure_rollback(invalid_defaults[d],fault);
    test_default_config_retry();test_shadow_request_retry();test_cancel_dialog_and_menu_cleanup();test_failed_init_can_leave();
    printf("PASS %u real Chameleon exit cases: NOSPC/IO/config/compare/settings failures retain owner and RAM; retry then exit/reload; defaults without preload, Shadow/REQ, cancel and write-free cleanup\n",cases);
    return 0;
}
