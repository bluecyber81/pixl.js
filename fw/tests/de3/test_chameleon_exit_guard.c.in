static void mui_view_dispatcher_add_view(mui_view_dispatcher_t *d,uint32_t id,mui_view_t *view) {
    assert(d->view_count<8);d->views[d->view_count].id=id;d->views[d->view_count++].view=view;
}
static void mui_view_dispatcher_switch_to_view(mui_view_dispatcher_t *d,uint32_t id) {
    if(id==VIEW_NONE){d->p_active_view=NULL;return;}
    for(unsigned i=0;i<d->view_count;i++)if(d->views[i].id==id){d->p_active_view=d->views[i].view;return;}
    assert(0);
}
static void mui_view_dispatcher_attach(mui_view_dispatcher_t *d,unsigned layer) {}
static void mui_view_dispatcher_detach(mui_view_dispatcher_t *d,unsigned layer) {}
static void mui_scene_dispatcher_set_user_data(mui_scene_dispatcher_t *d,void *u) {d->user_data=u;}
static void mui_scene_dispatcher_set_scene_defines(mui_scene_dispatcher_t *d,const void *defs,unsigned count) {}
static unsigned mui_scene_dispatcher_current_scene(mui_scene_dispatcher_t *d) {return d->scene;}
static void mui_scene_dispatcher_next_scene(mui_scene_dispatcher_t *d,unsigned scene) {
    d->scene=scene;d->active=true;app_chameleon_t *app=d->user_data;
    if(scene==CHAMELEON_SCENE_MAIN) {irq_enabled=true;tag_emulation_sense_run();mui_view_dispatcher_switch_to_view(app->p_view_dispatcher,CHAMELEON_VIEW_ID_MAIN);}
    else mui_view_dispatcher_switch_to_view(app->p_view_dispatcher,CHAMELEON_VIEW_ID_LIST);
}
static void mui_scene_dispatcher_exit(mui_scene_dispatcher_t *d) {
    if (!d->active) return;
    scenes_exited++;
    d->active=false;
    if(d->scene==CHAMELEON_SCENE_MENU)chameleon_scene_menu_on_exit(d->user_data);
    else if(d->scene==CHAMELEON_SCENE_MAIN){tag_emulation_sense_end();hal_nfc_set_nrfx_irq_enable(false);}
}
