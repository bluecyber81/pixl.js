/* Real protocol + runtime; storage, BLE and reboot boundaries mocked. */
static bool geometry_ok=true, import_pending=true, import_bound, handles_idle=true;
static unsigned finish_calls,bind_calls,reboot_calls,disable_calls;
static int32_t finish_error,bind_error;
static uint8_t archive_digest[32];
bool vfs_packed_geometry_valid(void){return geometry_ok;}
bool vfs_packed_import_pending(void){return import_pending;}
bool vfs_packed_handles_idle(void){return handles_idle;}
bool vfs_packed_import_identity(uint8_t out[32]){
    if(!import_bound)return false;memcpy(out,archive_digest,32);return true;
}
int32_t vfs_packed_finish_import(void){
    ++finish_calls;if(finish_error)return finish_error;
    if(!import_bound)return VFS_ERR_FAIL;import_pending=false;return 0;
}
int32_t vfs_packed_bind_import(const uint8_t in[32]){
    ++bind_calls;if(bind_error)return bind_error;
    import_bound=true;memcpy(archive_digest,in,32);return 0;
}
void ble_disable(void){++disable_calls;}
void system_reboot(void){++reboot_calls;CHECK(disable_calls==reboot_calls);}
const vfs_driver_t vfs_driver_fs={.mounted=mock_mounted};
@RUNTIME@

static df_frame_t state(uint8_t op){
    df_frame_t f={.cmd=0x20,.length=op==3?34:2,.data={'E',op}};
    if(op==3)for(unsigned i=0;i<32;++i)f.data[i+2]=(uint8_t)(31-i);
    return f;
}
static void request(df_frame_t f){dispatch(&f,DF_EVENT_DATA_RECEVIED);}
static void ready(void){df_frame_t f=state(2);dispatch(&f,DF_EVENT_DATA_TRANSMIT_READY);}
static uint32_t read32(const uint8_t *p){return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
int main(int argc,char **argv){
    CHECK(argc==2);unsigned scenario=(unsigned)strtoul(argv[1],NULL,10);reset();
    df_frame_t layout={.cmd=0x1f,.length=1,.data={'E'}};
    if(scenario==0 || scenario==1){
        if(scenario==1)mounted=false;
        request(layout);CHECK(response.status==0 && response.length==72);
        CHECK(response.data[0]==1 && response.data[1]=='E' && response.data[2]==3 && response.data[3]==mounted);
        CHECK(read32(response.data+4)==0x31534650 && read32(response.data+8)==2097152);
        CHECK(read32(response.data+12)==4096 && read32(response.data+16)==512);
        CHECK(response.data[20]==0 && response.data[21]==1 && response.data[26]==128);
        CHECK(read32(response.data+28)==32768 && response.data[32]==64 && response.data[33]==64);
        CHECK(response.data[34]==48 && response.data[35]==8 && read32(response.data+36)==7);
        const uint8_t expected[32]=PIXL_PACKED_ENGINE_SHA256_BYTES;
        CHECK(!memcmp(response.data+40,expected,32));
    }else if(scenario==2){geometry_ok=false;request(layout);CHECK(response.status==DF_STATUS_ERR && last_error==VFS_ERR_NODEV);
    }else if(scenario==3){
        df_frame_t bad=layout;bad.length=0;expect_bad(bad);bad=layout;bad.length=2;expect_bad(bad);
        bad=layout;bad.status=1;expect_bad(bad);bad=layout;bad.chunk=1;expect_bad(bad);
        bad=layout;bad.data[0]='X';expect_bad(bad);bad.data[0]='I';expect_bad(bad);
        enabled=false;expect_bad(layout);
    }else if(scenario==4){
        mounted=false;request(state(0));CHECK(response.status==0 && response.length==40);
        CHECK(response.data[3]==0 && response.data[4]==0 && response.data[5]==0 && response.data[6]==0);
        for(unsigned i=8;i<40;++i)CHECK(!response.data[i]);
    }else if(scenario==5){
        request(state(3));CHECK(response.status==0 && response.length==40 && bind_calls==1);
        CHECK(response.data[4]==1 && response.data[5]==0 && response.data[6]==1);
        for(unsigned i=0;i<32;++i)CHECK(response.data[i+8]==31-i);
    }else if(scenario==6){
        for(unsigned op=0;op<4;++op){df_frame_t f=state(op);--f.length;expect_bad(f);
            f=state(op);++f.length;expect_bad(f);f=state(op);f.status=1;expect_bad(f);
            f=state(op);f.chunk=1;expect_bad(f);f=state(op);f.data[0]='I';expect_bad(f);}
        df_frame_t f=state(0);f.data[1]=4;expect_bad(f);CHECK(!bind_calls && !finish_calls && !reboot_calls);
    }else if(scenario==7){
        for(unsigned mode=0;mode<4;++mode){reset();
            if(mode==0)file_chunk_state.opened=true;if(mode==1)file_chunk_state.abandoned=true;
            if(mode==2)file_chunk_state.read_pending=true;if(mode==3)dir_chunk_state.dir_closed=false;
            for(unsigned op=1;op<4;++op)expect_bad(state(op));
            request(state(0));CHECK(response.status==0);}
        CHECK(!bind_calls && !finish_calls && !reboot_calls);
    }else if(scenario==8 || scenario==9){
        if(scenario==8)handles_idle=false;else mounted=false;
        for(unsigned op=1;op<4;++op)expect_bad(state(op));request(state(0));CHECK(response.status==0);
        CHECK(!bind_calls && !finish_calls && !reboot_calls);
    }else if(scenario==10){
        finish_error=VFS_ERR_NOSPC;request(state(1));CHECK(response.status==DF_STATUS_ERR && last_error==VFS_ERR_NOSPC);
        CHECK(import_pending && finish_calls==1);ready();CHECK(!reboot_calls);
    }else if(scenario==11){request(state(2));CHECK(response.status==DF_STATUS_ERR);ready();CHECK(!reboot_calls);
    }else if(scenario==12){
        vfs_packed_latch_recovery();request(state(3));request(state(1));
        CHECK(response.status==0 && !response.data[4] && response.data[5] && response.data[6] && response.data[7]);
        CHECK(vfs_packed_recovery_required());request(state(2));CHECK(response.status==0 && !reboot_calls);
        ready();CHECK(reboot_calls==1);ready();CHECK(reboot_calls==1);
    }else if(scenario==13){
        import_pending=false;request(state(2));CHECK(response.status==0);
        df_proto_vfs_cleanup();ready();CHECK(!reboot_calls);
    }else if(scenario==14){
        import_pending=false;request(state(2));df_frame_t bad=state(0);bad.length=0;expect_bad(bad);
        ready();CHECK(!reboot_calls);
    }else if(scenario==15){
        for(unsigned e=0;e<=DF_EVENT_DATA_TRANSMIT_READY;++e){if(e==DF_EVENT_DATA_RECEVIED)continue;
            dispatch(&layout,(df_event_type_t)e);df_frame_t s=state(0);dispatch(&s,(df_event_type_t)e);}
        CHECK(!sends && !bind_calls && !finish_calls && !reboot_calls);
    }else if(scenario==16){
        import_pending=false;CHECK(!vfs_packed_recovery_required());mounted=false;
        CHECK(vfs_packed_recovery_required());vfs_packed_latch_recovery();mounted=true;
        CHECK(vfs_packed_recovery_required());request(state(0));CHECK(response.data[7]);
    }else if(scenario==17){
        bind_error=VFS_ERR_NOSPC;request(state(3));CHECK(response.status==DF_STATUS_ERR && last_error==VFS_ERR_NOSPC);
        CHECK(!import_bound && import_pending && bind_calls==1);
    }else if(scenario==18){
        df_frame_t f={.cmd=0x1c,.length=1,.data={'E'}};request(f);
        CHECK(response.status==0 && response.length==8 && response.data[2]==3 && response.data[5]==128);
    }else if(scenario==19){
        df_frame_t f={.cmd=0x11,.length=1,.data={'E'}};
        f.status=1;expect_bad(f);f.status=0;f.chunk=1;expect_bad(f);f.chunk=0;f.length=2;expect_bad(f);
    }else CHECK(!"unknown scenario");
    CHECK(!format_calls && !mount_calls && !dfu_calls);
    printf("PASS packed recovery protocol scenario %u\n",scenario);return 0;
}
