#include <stddef.h>
#include <assert.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
typedef unsigned ret_code_t;
typedef unsigned app_pwm_duty_t;
typedef struct {int pin_polarity[1];} app_pwm_config_t;
enum {NRF_SUCCESS=0,NRF_ERROR_BUSY=17,NRF_ERROR_TIMEOUT=13,NRF_ERROR_INVALID_STATE=8,
      NRFX_DRV_STATE_POWERED_ON=2,APP_PWM_POLARITY_ACTIVE_HIGH=1};
#define APP_PWM_DEFAULT_CONFIG_1CH(period,pin) ((app_pwm_config_t){0})
#define LCD_BL_PIN 30
#define LCD_SCREEN
#define NRF_LOG_INFO(...) ((void)0)
#define NRF_LOG_WARNING(...) ((void)0)
#define _T(x) #x
typedef struct {unsigned state;} control_t;
typedef struct {control_t*p_cb;} app_pwm_t;
static control_t control;
static app_pwm_t pwm1={&control};
static bool m_pwm_initialized;
typedef struct {uint8_t lcd_backlight;unsigned oled_contrast,sleep_timeout_sec,language;bool flip_display;} settings_data_t;
static settings_data_t settings;
#define APP_SETTINGS_CHANGED(app,field) ((app)->changed_fields |= UINT32_C(1)<<offsetof(settings_data_t,field))
#define SETTINGS_SET(field, value) (settings_get_data()->field = (value))
static settings_data_t*settings_get_data(void){return &settings;}
static unsigned calls,delays,enables,disables,init_calls,get_calls,init_error,duty_error,busy_calls,duty;
static ret_code_t app_pwm_init(app_pwm_t*p,app_pwm_config_t*c,void*cb){
 assert(p==&pwm1 && c->pin_polarity[0]==1 && cb==NULL);init_calls++;
 if(!init_error)control.state=1;
 return init_error;
}
static void app_pwm_enable(app_pwm_t*p){assert(p==&pwm1 && m_pwm_initialized);control.state=2;duty=0;enables++;}
static void app_pwm_disable(app_pwm_t*p){assert(p==&pwm1 && m_pwm_initialized);control.state=1;duty=0;disables++;}
static ret_code_t app_pwm_channel_duty_set(app_pwm_t*p,unsigned ch,app_pwm_duty_t value){
 assert(p==&pwm1 && ch==0 && m_pwm_initialized && control.state==2 && value<=100);
 calls++;if(calls<=busy_calls)return NRF_ERROR_BUSY;
 if(duty_error)return duty_error;
 duty=value;return NRF_SUCCESS;
}
static app_pwm_duty_t app_pwm_channel_duty_get(app_pwm_t*p,unsigned ch){
 assert(p==&pwm1 && ch==0 && m_pwm_initialized && control.state==2);get_calls++;return duty;
}
static void nrf_delay_us(unsigned us){assert(us==10);delays++;}
typedef struct {void*p_scene_dispatcher,*p_toast_view;uint32_t changed_fields;} app_settings_t;
typedef struct {void*user_data;int32_t current;} mui_progress_bar_t;
typedef unsigned mui_progress_bar_event_t;
enum {MUI_PROGRESS_BAR_EVENT_DECREMENT,MUI_PROGRESS_BAR_EVENT_INCREMENT,MUI_PROGRESS_BAR_EVENT_CONFIRMED};
static int32_t mui_progress_bar_get_current_value(mui_progress_bar_t*p){return p->current;}
static void mui_progress_bar_set_current_value(mui_progress_bar_t*p,int32_t n){p->current=n;}
static unsigned left_scenes,toasts,contrast_sets,flip_sets,sleep_sets,language_sets;
static const char*last_toast;
static void mui_scene_dispatcher_previous_scene(void*p){(void)p;left_scenes++;}
static void mui_toast_view_show(void*p,const char*s){(void)p;toasts++;last_toast=s;}
static void mui_u8g2_set_contrast_level(unsigned n){(void)n;contrast_sets++;}
static void mui_u8g2_set_flip_display(bool n){(void)n;flip_sets++;}
#define ble_set_standby_timeout nrf_pwr_mgmt_set_timeout
static void nrf_pwr_mgmt_set_timeout(unsigned n){(void)n;sleep_sets++;}
static void setLanguage(unsigned n){(void)n;language_sets++;}
static bool m_dimmed, m_dim_retry_pending, opt_in;
static bool m_backlight_preview_active,m_backlight_restore_pending;
static uint8_t m_backlight_saved;
static uint32_t m_backlight_retry_tick;
static uint16_t m_timeout_counter, m_standby_counter;
static uint8_t m_input_idle_seconds;
#define __STATIC_INLINE static inline
#define NRF_PWR_MGMT_SHUTDOWN_GOTO_SYSOFF 1
static bool m_shutdown_started;
static unsigned shutdown_requests;
static void nrf_pwr_mgmt_shutdown(unsigned kind){assert(kind==1);++shutdown_requests;}
static uint32_t rtc;
#define APP_TIMER_TICKS(ms) (ms)
static uint32_t app_timer_cnt_get(void) {return rtc;}
static uint32_t app_timer_cnt_diff_compute(uint32_t now,uint32_t previous) {return (now-previous)&0xffffffu;}
static bool settings_get_lcd_dim(void) {return opt_in;}
@PRODUCTION@
static void reset(bool initialized,bool powered){
 calls=delays=enables=disables=init_calls=get_calls=init_error=duty_error=busy_calls=0;
 left_scenes=toasts=contrast_sets=flip_sets=sleep_sets=language_sets=0;last_toast=NULL;
 m_pwm_initialized=initialized;control.state=powered?2:initialized?1:0;duty=powered?30:0;
 settings=(settings_data_t){.lcd_backlight=30};
 m_dimmed=m_dim_retry_pending=m_backlight_preview_active=m_backlight_restore_pending=false;
 m_backlight_saved=0;m_backlight_retry_tick=0;
}
int main(void){unsigned cases=0;
 reset(false,false);init_error=NRF_ERROR_INVALID_STATE;
 assert(pwm_init()==NRF_ERROR_INVALID_STATE && init_calls==1 && !m_pwm_initialized);
 assert(mui_u8g2_set_backlight_level(0)==NRF_ERROR_INVALID_STATE);
 assert(mui_u8g2_set_backlight_level(50)==NRF_ERROR_INVALID_STATE);
 assert(mui_u8g2_get_backlight_level()==-1 && !calls&&!enables&&!disables&&!get_calls);cases++;
 init_error=0;assert(pwm_init()==NRF_SUCCESS && init_calls==2 && m_pwm_initialized && duty==30);cases++;
 for(unsigned powered=0;powered<2;powered++)for(unsigned n=0;n<250;n++){
  reset(true,powered);busy_calls=n;
  ret_code_t result=mui_u8g2_set_backlight_level(70);
  if(n<200){assert(result==NRF_SUCCESS && duty==70 && calls==n+1 && delays==n && !disables);}
  else {assert(result==NRF_ERROR_TIMEOUT && calls==200 && delays==199);
   assert(duty==(powered?30:0) && disables==!powered && control.state==(powered?2:1));}
  cases++;
 }
 for(unsigned powered=0;powered<2;powered++){
  reset(true,powered);duty_error=NRF_ERROR_INVALID_STATE;
  assert(mui_u8g2_set_backlight_level(70)==NRF_ERROR_INVALID_STATE && calls==1 && !delays);
  assert(duty==(powered?30:0) && disables==!powered);cases++;
 }
 for(unsigned value=0;value<=255;value++){
  reset(true,true);assert(mui_u8g2_set_backlight_level(value)==NRF_SUCCESS);
  assert(mui_u8g2_get_backlight_level()==(int)(value>100?100:value));cases++;
 }
 reset(false,false);busy_calls=100000;assert(pwm_init()==NRF_ERROR_TIMEOUT);
 assert(calls==200 && delays==199 && disables==1 && mui_u8g2_get_backlight_level()==0);cases++;
 app_settings_t app={0};mui_progress_bar_t bar={.user_data=&app};
 for(unsigned event=0;event<3;event++)for(unsigned powered=0;powered<2;powered++){
  reset(true,powered);bar.current=70;busy_calls=100000;
  settings_scene_lcd_backlight_event_cb(event,&bar);
  assert(settings.lcd_backlight==30 && left_scenes==0 && toasts==1 && !strcmp(last_toast,"ERR"));
  assert(bar.current==(powered?30:0));cases++;
 }
 reset(false,false);bar.current=70;settings_scene_lcd_backlight_event_cb(MUI_PROGRESS_BAR_EVENT_CONFIRMED,&bar);
 assert(bar.current==30 && settings.lcd_backlight==30 && toasts==1 && !left_scenes && !get_calls);cases++;
 reset(true,true);bar.current=60;settings_scene_lcd_backlight_event_cb(MUI_PROGRESS_BAR_EVENT_INCREMENT,&bar);
 assert(duty==60 && settings.lcd_backlight==30 && !toasts && !left_scenes);
 settings_scene_lcd_backlight_event_cb(MUI_PROGRESS_BAR_EVENT_CONFIRMED,&bar);
 assert(settings.lcd_backlight==60 && left_scenes==1 && !toasts);cases++;
 reset(false,false);settings_reset_default(&app);
 assert(toasts==1 && !strcmp(last_toast,"ERR") && contrast_sets==1 && flip_sets==1 && sleep_sets==1 && language_sets==1);cases++;
 reset(true,true);settings_reset_default(&app);
 assert(toasts==1 && !strcmp(last_toast,"APP_SET_RESET_DEFAULT_SUCCESS"));cases++;
 reset(true,true);
 // Simulate a live NFC or BLE session feeding standby every second.
 m_timeout_counter=180;
 for(unsigned second=1;second<=300;++second){
   pwr_mgmt_standby_timeout_check();
   pwr_mgmt_standby_timeout_clear();
   assert(!nrf_pwr_mgmt_dim_window(0) && nrf_pwr_mgmt_dim_window(5)==(second>=5));
   assert(nrf_pwr_mgmt_dim_window(15)==(second>=15) && nrf_pwr_mgmt_dim_window(30)==(second>=30));
 }
 assert(m_input_idle_seconds==255 && !shutdown_requests);
 nrf_pwr_mgmt_input_activity();assert(!nrf_pwr_mgmt_dim_window(5));
 m_timeout_counter=0;for (unsigned i=0;i<30;i++)pwr_mgmt_standby_timeout_check();
 assert(nrf_pwr_mgmt_dim_window(30) && !shutdown_requests);
 m_timeout_counter=180;
 m_standby_counter=174;assert(!nrf_pwr_mgmt_dim_window(0));
 m_standby_counter=175;assert(nrf_pwr_mgmt_dim_window(0));
 mui_u8g2_poll_dim(true);assert(!calls && duty==30);
 opt_in=true;mui_u8g2_poll_dim(true);assert(calls==1 && duty==8);
 mui_u8g2_poll_dim(true);assert(calls==1 && settings.lcd_backlight==30);
 m_standby_counter=0;mui_u8g2_poll_dim(nrf_pwr_mgmt_dim_window(0));assert(calls==2 && duty==30);
 for (unsigned level=0;level<=100;level++){
   settings.lcd_backlight=level;unsigned previous=calls;
   mui_u8g2_poll_dim(true);
   if(level<2){assert(calls==previous);continue;}
   assert(calls==previous+1 && duty==(level+3)/4);
   opt_in=false;mui_u8g2_poll_dim(true);assert(duty==level && calls==previous+2);
   opt_in=true;
 }
 m_timeout_counter=0;m_standby_counter=60000;assert(!nrf_pwr_mgmt_dim_window(0));
 m_timeout_counter=5;assert(!nrf_pwr_mgmt_dim_window(0));
 settings.lcd_backlight=30;rtc=0xfffff0;duty_error=NRF_ERROR_INVALID_STATE;
 unsigned previous=calls;mui_u8g2_poll_dim(true);assert(calls==previous+1 && !m_dimmed);
 rtc=(rtc+249)&0xffffff;mui_u8g2_poll_dim(true);assert(calls==previous+1);
 rtc++;duty_error=0;mui_u8g2_poll_dim(true);assert(calls==previous+2 && duty==8);
 duty_error=NRF_ERROR_INVALID_STATE;mui_u8g2_poll_dim(false);assert(calls==previous+3 && duty==8);
 rtc+=249;mui_u8g2_poll_dim(false);assert(calls==previous+3);
 rtc++;duty_error=0;mui_u8g2_poll_dim(false);assert(calls==previous+4 && duty==30);
 // Preview must survive auto-dim polling, preserve configured brightness,
 // restore a genuinely off output, and retain no reference to an app object.
 for(unsigned original=0;original<=100;original++){
   reset(true,true);opt_in=true;settings.lcd_backlight=original;
   assert(mui_u8g2_set_backlight_level(original)==0);
   assert(mui_u8g2_backlight_preview(5)==0 && m_backlight_preview_active && duty==5);
   for(unsigned i=0;i<300;i++){rtc++;mui_u8g2_poll_dim(true);assert(duty==5);}
   assert(mui_u8g2_backlight_preview(100)==0 && duty==100);
   assert(mui_u8g2_backlight_restore()==0 && duty==original && !m_backlight_preview_active);
   assert(settings.lcd_backlight==original && !m_backlight_restore_pending);
   assert(mui_u8g2_backlight_restore()==0 && duty==original);
 }
 reset(false,false);assert(mui_u8g2_backlight_preview(5)==NRF_ERROR_INVALID_STATE);
 assert(!m_backlight_preview_active && !calls);
 reset(true,true);duty_error=8;assert(mui_u8g2_backlight_preview(5)==8);
 assert(!m_backlight_preview_active && duty==30);duty_error=0;
 assert(mui_u8g2_backlight_preview(5)==0);duty_error=8;
 assert(mui_u8g2_backlight_preview(100)==8 && duty==5 && m_backlight_saved==30);
 rtc=0xfffff0;assert(mui_u8g2_backlight_restore()==8 && m_backlight_restore_pending);
 assert(mui_u8g2_backlight_preview(100)==NRF_ERROR_BUSY && duty==5);
 previous=calls;rtc=(rtc+249)&0xffffff;mui_u8g2_poll_dim(false);assert(calls==previous);
 rtc=(rtc+1)&0xffffff;mui_u8g2_poll_dim(false);assert(calls==previous+1 && duty==5);
 rtc+=250;duty_error=0;mui_u8g2_poll_dim(false);
 assert(duty==30 && !m_backlight_restore_pending && !m_backlight_preview_active);
 reset(true,true);opt_in=true;mui_u8g2_poll_dim(true);assert(duty==8 && m_dimmed);
 assert(mui_u8g2_backlight_preview(100)==0 && m_backlight_saved==8);
 assert(mui_u8g2_backlight_restore()==0 && duty==8);
 mui_u8g2_poll_dim(false);assert(duty==30 && !m_dimmed);
 // A later successful user setting owns the output. It supersedes either
 // an active preview or a failed restore, including when preview began dimmed.
 unsigned superseded=0;
 for(unsigned chosen=0;chosen<=80;chosen+=80)for(unsigned pending=0;pending<2;pending++)
 for(unsigned dimmed=0;dimmed<2;dimmed++)for(unsigned path=0;path<3;path++){
   reset(true,true);opt_in=dimmed;rtc=0;
   if(dimmed){mui_u8g2_poll_dim(true);assert(duty==8 && m_dimmed);}
   assert(mui_u8g2_backlight_preview(5)==0);
   if(pending){duty_error=8;assert(mui_u8g2_backlight_restore()==8);assert(m_backlight_restore_pending);}
   duty_error=0;rtc=50;bar.current=chosen;
   if(path==0)assert(mui_u8g2_set_backlight_level(chosen)==0);
   else settings_scene_lcd_backlight_event_cb(path==1?MUI_PROGRESS_BAR_EVENT_INCREMENT:MUI_PROGRESS_BAR_EVENT_CONFIRMED,&bar);
   assert(mui_u8g2_get_backlight_level()==(int)chosen);
   assert(!m_backlight_preview_active && !m_backlight_restore_pending && !m_dimmed && !m_dim_retry_pending);
   assert(settings.lcd_backlight==(path==2?chosen:30));
   unsigned done_calls=calls;rtc=250;mui_u8g2_poll_dim(false);
   rtc=500;mui_u8g2_poll_dim(false);
   assert(mui_u8g2_backlight_restore()==0);
   assert(calls==done_calls && mui_u8g2_get_backlight_level()==(int)chosen);
   // The next preview saves the newer output, never the superseded 8/30.
   assert(mui_u8g2_backlight_preview(5)==0 && m_backlight_saved==chosen);
   assert(mui_u8g2_backlight_restore()==0 && mui_u8g2_get_backlight_level()==(int)chosen);
   superseded++;
 }
 // Failures are not a new setting: retain the old restore target and retry it.
 for(unsigned timeout=0;timeout<2;timeout++)for(unsigned path=0;path<2;path++){
   reset(true,true);opt_in=false;rtc=0;
   assert(mui_u8g2_backlight_preview(5)==0);duty_error=8;
   assert(mui_u8g2_backlight_restore()==8 && m_backlight_restore_pending);
   if(timeout){duty_error=0;busy_calls=calls+200;}
   if(path==0)assert(mui_u8g2_set_backlight_level(80)==(timeout?NRF_ERROR_TIMEOUT:8));
   else {bar.current=80;settings_scene_lcd_backlight_event_cb(MUI_PROGRESS_BAR_EVENT_CONFIRMED,&bar);assert(toasts==1 && !left_scenes && bar.current==5);}
   assert(m_backlight_restore_pending && m_backlight_saved==30 && duty==5 && settings.lcd_backlight==30);
   duty_error=0;busy_calls=0;rtc=249;unsigned done_calls=calls;
   mui_u8g2_poll_dim(false);assert(calls==done_calls && duty==5);
   rtc=250;mui_u8g2_poll_dim(false);assert(duty==30 && !m_backlight_restore_pending);
 }
 reset(true,true);opt_in=false;rtc=0;
 assert(mui_u8g2_backlight_preview(5)==0);duty_error=8;
 assert(mui_u8g2_backlight_restore()==8);m_pwm_initialized=false;
 assert(mui_u8g2_set_backlight_level(0)==NRF_ERROR_INVALID_STATE && m_backlight_restore_pending);
 m_pwm_initialized=true;duty_error=0;rtc=250;mui_u8g2_poll_dim(false);assert(duty==30);
 // A failed user request also leaves an active preview owned by its test.
 reset(true,true);opt_in=true;
 assert(mui_u8g2_backlight_preview(5)==0);duty_error=8;
 assert(mui_u8g2_set_backlight_level(80)==8 && m_backlight_preview_active);
 mui_u8g2_poll_dim(true);assert(duty==5);
 duty_error=0;assert(mui_u8g2_backlight_restore()==0 && duty==30);
 printf("PASS %u newer user settings supersede preview/restore through direct and real settings callbacks; failed requests retain restore ownership.\n",superseded);
 puts("PASS LCD preview: all101 saved levels, auto-dim suppression, restore failures/retry/RTC wrap, off/dimmed return and settings unchanged");
 puts("PASS last-five-second dim window, 101 brightness levels, activity restore, opt-out, off, PWM failure recovery and 24-bit RTC rollover");
 printf("PASS %u actual PWM/settings cases: bounded BUSY, immediate errors, init failure/retry, no uninitialized SDK access, old output/config preserved, no false confirmation, all256 values.\n",cases);
}
