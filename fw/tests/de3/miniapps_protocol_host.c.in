#include <assert.h>
#include <stdio.h>
#include <string.h>
#include "stream_codec.h"
#include "switch2_protocol.h"

static unsigned checks;
#define CHECK(x) do { assert(x); ++checks; } while(0)
static size_t constant_rle(uint8_t *out, uint8_t value) {
    size_t count=1024, pos=0;
    while(count) { size_t run=count>129?129:count; assert(run>=2); out[pos++]=(uint8_t)(128+run-2); out[pos++]=value; count-=run; }
    return pos;
}
static unsigned feed_frame(stream_codec_t *c,uint8_t flags,const uint8_t *bytes,size_t size,size_t chunk) {
    uint8_t wire[1030]={0xa5,0x5a,flags,(uint8_t)size,(uint8_t)(size>>8)};
    assert(size<=1025);memcpy(wire+5,bytes,size);
    unsigned complete=0;
    for(size_t pos=0;pos<size+5;) {size_t n=size+5-pos;if(n>chunk)n=chunk;complete+=stream_codec_feed(c,wire+pos,n);pos+=n;}
    return complete;
}
static void codec_tests(void) {
    stream_codec_t c; uint8_t raw[1025],rle[32],prior[1024];
    for(unsigned i=0;i<sizeof(raw);++i)raw[i]=(uint8_t)(i*37+9);
    for(unsigned chunk=1;chunk<=247;chunk+=17) {
        memset(&c,0,sizeof(c));stream_codec_reset(&c);
        CHECK(feed_frame(&c,0,raw,1024,chunk)==1);
        CHECK(c.has_frame&&!memcmp(c.frame,raw,1024));
    }
    size_t length=constant_rle(rle,0x5a);
    CHECK(feed_frame(&c,1,rle,length,3)==1);
    for(unsigned i=0;i<1024;++i)CHECK(c.frame[i]==0x5a);
    length=constant_rle(rle,0xff);
    CHECK(feed_frame(&c,2,rle,length,1)==1);
    for(unsigned i=0;i<1024;++i)CHECK(c.frame[i]==0xa5);
    memcpy(prior,c.frame,sizeof(prior));
    stream_codec_reset(&c);
    CHECK(feed_frame(&c,2,rle,length,247)==0&&!c.has_frame);
    CHECK(!memcmp(c.frame,prior,1024));
    CHECK(feed_frame(&c,0,raw,1024,247)==1);
    memcpy(prior,c.frame,sizeof(prior));
    uint8_t malformed[][4]={{2,7,8,0},{255,1,255,2}};
    CHECK(feed_frame(&c,1,malformed[0],3,1)==0&&!c.has_frame);
    CHECK(!memcmp(c.frame,prior,1024));
    CHECK(feed_frame(&c,0,raw,1024,247)==1);
    uint8_t overflow[16];for(unsigned i=0;i<16;i+=2){overflow[i]=255;overflow[i+1]=3;}
    CHECK(feed_frame(&c,1,overflow,16,247)==0&&!c.has_frame);
    CHECK(!memcmp(c.frame,prior,1024));
    CHECK(feed_frame(&c,0,raw,20,247)==0&&!c.has_frame);
    CHECK(feed_frame(&c,3,raw,1024,247)==0&&!c.has_frame);
    CHECK(feed_frame(&c,0,raw,1025,247)==0&&!c.has_frame);
    CHECK(feed_frame(&c,0,raw,1024,247)==1);
    uint8_t zero[]={0xa5,0x5a,0,0,0};CHECK(!stream_codec_feed(&c,zero,sizeof(zero))&&!c.has_frame);
    uint8_t extra[32];length=constant_rle(extra,0x70);extra[length++]=0;extra[length++]=1;
    CHECK(feed_frame(&c,1,extra,length,247)==0&&!c.has_frame);
    CHECK(feed_frame(&c,0,raw,1024,247)==1);
    const uint8_t first[]={0xa5,0x5a,0,0,4,7,8};
    CHECK(!stream_codec_feed(&c,first,sizeof(first)));
    stream_codec_reset(&c);
    CHECK(feed_frame(&c,2,rle,constant_rle(rle,1),247)==0&&!c.has_frame);
    CHECK(feed_frame(&c,0,raw,1024,247)==1);
    CHECK(!stream_codec_feed(&c,NULL,1));
    CHECK(!stream_codec_feed(NULL,raw,1));
}
static void switch_tests(void) {
    switch2_wake_cfg_t c, before, parsed; uint8_t adv[31], packet[39],mac[6];char text[300];
    switch2_wake_cfg_set_default(&c);
    CHECK(!c.auto_wake&&!c.connectable&&c.pid==0x2066);
    CHECK(parse_mac_str("AA:BB:CC:DD:EE:02",mac));
    CHECK(mac[0]==0xaa&&mac[5]==2);
    uint8_t copy[6];memcpy(copy,mac,6);
    CHECK(!parse_mac_str("AA:BB:CC:DD:EE:GG",mac)&&!memcmp(mac,copy,6));
    CHECK(!parse_mac_str("000000000000",mac));
    CHECK(!parse_mac_str("FFFFFFFFFFFF",mac));
    CHECK(!parse_mac_str("11223344556",mac));
    CHECK(!parse_mac_str("11223344556677",mac));
    CHECK(!switch2_wake_build_adv(&c,adv));
    c.has_mac=c.has_host=true;memcpy(c.controller_mac,copy,6);
    CHECK(parse_mac_str("10:20:30:40:50:60",c.host_mac));
    CHECK(switch2_wake_build_adv(&c,adv)==31);
    CHECK(adv[12]==0x66&&adv[13]==0x20&&adv[16]==0x81&&adv[17]==0x60&&adv[22]==0x10);
    packet[0]=2;packet[1]=37;for(unsigned i=0;i<6;++i)packet[2+i]=c.controller_mac[5-i];memcpy(packet+8,adv,31);
    ble_switch2_scan_result_t result;
    memset(&result,0x7e,sizeof(result));
    for(size_t size=0;size<39;++size)CHECK(!switch2_wake_parse_packet(packet,size,&result));
    CHECK(switch2_wake_parse_packet(packet,39,&result));
    CHECK(!memcmp(result.controller_mac,c.controller_mac,6)&&!memcmp(result.host_mac,c.host_mac,6)&&result.pid==0x2066&&result.adv_len==31);
    ble_switch2_scan_result_t saved=result;
    packet[0]|=0x40;CHECK(!switch2_wake_parse_packet(packet,39,&result));packet[0]=2;
    packet[1]=38;CHECK(!switch2_wake_parse_packet(packet,39,&result));packet[1]=37;
    packet[8+16]=0x80;CHECK(!switch2_wake_parse_packet(packet,39,&result));packet[8+16]=0x81;
    packet[8+9]=4;CHECK(!switch2_wake_parse_packet(packet,39,&result));packet[8+9]=3;
    packet[8+3]=40;CHECK(!switch2_wake_parse_packet(packet,39,&result));packet[8+3]=27;
    CHECK(!memcmp(&saved,&result,sizeof(result)));
    c.auto_wake=true;c.connectable=true;
    int size=switch2_wake_format_cfg(&c,text,sizeof(text));CHECK(size>0&&size<256);
    CHECK(switch2_wake_parse_cfg(&parsed,text));
    CHECK(parsed.auto_wake&&parsed.connectable&&parsed.pid==c.pid&&!memcmp(parsed.host_mac,c.host_mac,6));
    memcpy(c.raw_data,adv,31);c.has_raw_data=true;c.raw_data_len=31;
    size=switch2_wake_format_cfg(&c,text,sizeof(text));CHECK(size>0&&size<256);
    CHECK(switch2_wake_parse_cfg(&parsed,text)&&parsed.has_raw_data);
    CHECK(switch2_wake_build_adv(&parsed,adv)==31&&!memcmp(adv,c.raw_data,31));
    CHECK(switch2_wake_format_cfg(&c,text,20)<0);
    before=parsed;
    const char *bad[]={"mac=oops\n","pid=2\n","mode=other\n","auto_wake=10\n","data=020106\n","host=000000000000\n","mac\n"};
    for(unsigned i=0;i<sizeof(bad)/sizeof(bad[0]);++i){strcpy(text,bad[i]);CHECK(!switch2_wake_parse_cfg(&parsed,text));CHECK(!memcmp(&before,&parsed,sizeof(parsed)));}
    strcpy(text,"# comment\n\n mac = AA:BB:CC:DD:EE:02 # controller\r\n host = 10:20:30:40:50:60\npid = 2067 ; right\nmode = nonconn\nauto_wake = 0\n");
    CHECK(switch2_wake_parse_cfg(&parsed,text)&&parsed.has_mac&&parsed.has_host&&parsed.pid==0x2067&&!parsed.connectable&&!parsed.auto_wake);
    parsed.has_raw_data=false;CHECK(switch2_wake_build_adv(&parsed,adv)==31&&adv[12]==0x67);
}
int main(void) {
    codec_tests();switch_tests();
    printf("PASS PR479 production codec/config/packet functions: %u assertions; no radio/device claim\n",checks);
    return 0;
}
