#include "amiibo_view.h"
#include "amiibo_info_draw.h"
#include "mui_element.h"
#include "mui_qrcode_helper.h"
#include "db_header.h"
#include "i18n/language.h"
#include "amiibo_usage_de.h"
#include "expected_notes.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define CHECK(c) do { if (!(c)) { fprintf(stderr,"CHECK failed: %s line %d\n",#c,__LINE__); exit(71); } } while (0)
/*ACTUAL_DEFINES*/
static struct { bool anim_enabled,qrcode_enabled; } settings={true,true};
#define settings_get_data() (&settings)
static bool chinese,german,linked=true;
int getLanguage(void) { return german ? LANGUAGE_DE_DE : LANGUAGE_EN_US; }
static unsigned animation_starts,animation_stops,menu_events,desc_events,slot_events,frames,qr_checks;
static db_amiibo_t entry={"AAA","AAA"};
static db_notes_t descriptions={"Linked description with many useful details, enough text to scroll across multiple lines and pages. More information follows.",
                       "A different Chinese-language linked description with many details and enough text to cross several pages. More follows here."};
#ifdef LEGACY_INLINE_NOTES
#define link descriptions
#else
static db_link_t link={0};
static const db_notes_t *const db_usage_notes=&descriptions;
#endif
extern const char *const lang_de_DE[];
const char *getLangString(int id) { return lang_de_DE[id]; }
static bool isChineseLanguage(void) { return chinese; }
const db_amiibo_t *get_amiibo_by_id(uint32_t h,uint32_t t) {
    return (h==0 && t==2) || (h==4 && t==0x04431c02) || (h==0x000a0004 && t==0x04451c02) ? &entry : NULL;
}
static const db_link_t *get_link_by_id(unsigned game,uint32_t h,uint32_t t) {
    (void)game;return linked && get_amiibo_by_id(h,t) ? &link : NULL;
}
static void ntag_store_get_uuid(ntag_t *tag,uint8_t *uid) { (void)tag;memset(uid,0x12,7); }
static void mui_anim_stop(mui_anim_t *a) { (void)a;animation_stops++; }
static void mui_anim_set_time(mui_anim_t *a,uint32_t ms) { a->time=ms; }
static void mui_anim_set_values(mui_anim_t *a,int32_t start,int32_t end) { a->start_value=start;a->end_value=end; }
static void mui_anim_start(mui_anim_t *a) { animation_starts++;a->exec_cb(a->var,a->start_value); }
/*ACTUAL_ENDIAN_FUNCTION*/
/*ACTUAL_WRAPPER*/
#ifdef LEGACY_INLINE_NOTES
/* The DE3.24 view passed one height for both clipping and paging. Keep the
 * old call contract only inside that historical view for its QR control. */
#define mui_element_autowrap_text_box(c,x,y,w,h,off,r,text) \
    mui_element_autowrap_text_box((c),(x),(y),(w),(h),(h),(off),(r),(text))
#endif
/*ACTUAL_VIEW_FUNCTIONS*/
#ifdef LEGACY_INLINE_NOTES
#undef mui_element_autowrap_text_box
#endif

static const u8x8_display_info_t display_info={.tile_width=16,.tile_height=8,.pixel_width=128,.pixel_height=64};
static void setup(mui_canvas_t *c,u8g2_t *u,uint8_t *buf,unsigned height) {
    memset(u,0,sizeof(*u));memset(buf,0,1024);
    u->u8x8.display_info=&display_info;
    u8g2_SetupBuffer(u,buf,8,u8g2_ll_hvline_vertical_top_lsb,&u8g2_cb_r0);
    c->fb=u;mui_canvas_set_frame(c,0,0,128,height);
    mui_canvas_set_font(c,u8g2_font_wqy12_t_gb2312a);
    mui_canvas_set_draw_color(c,1);
}
static unsigned pixel(const uint8_t *buf,unsigned x,unsigned y) { return !!(buf[(y/8)*128+x]&(1U<<(y%8))); }
static void same_region(const uint8_t *a,const uint8_t *b,unsigned x0,unsigned y0,unsigned width,unsigned height) {
    for(unsigned y=y0;y<y0+height;y++)for(unsigned x=x0;x<x0+width;x++)CHECK(pixel(a,x,y)==pixel(b,x,y));
}
static void save_frame(const char *folder,const char *name,const uint8_t *buf) {
    char path[1024];snprintf(path,sizeof(path),"%s/%s.pbm",folder,name);
    FILE *f=fopen(path,"wb");CHECK(f);fprintf(f,"P1\n128 64\n");
    for(unsigned y=0;y<64;y++)for(unsigned x=0;x<128;x++)fprintf(f,"%u%c",pixel(buf,x,y),x==127?'\n':' ');
    fclose(f);
}
static void view_event(amiibo_view_event_t e,amiibo_view_t *v) {
    (void)v;if(e==AMIIBO_VIEW_EVENT_MENU)menu_events++;
    else if(e==AMIIBO_VIEW_EVENT_DESC_UPDATE)desc_events++;
    else if(e==AMIIBO_VIEW_EVENT_UPDATE)slot_events++;
}
static void init_view(amiibo_view_t *v,mui_view_t *view,ntag_t *tag) {
    memset(v,0,sizeof(*v));memset(tag,0,sizeof(*tag));tag->data[91]=2;tag->type=NTAG_215;
    v->ntag=tag;v->p_view=view;v->max_ntags=2;v->event_cb=view_event;
    v->desc_anim.var=v;v->desc_anim.exec_cb=amiibo_view_desc_anim_exec;view->user_data=v;
}
static void draw(mui_canvas_t *c,mui_view_t *view) {
    ntag_t before=*((amiibo_view_t *)view->user_data)->ntag;
    mui_rect_t prior,after;mui_canvas_get_clip_window(c,&prior);
    memset(c->fb->tile_buf_ptr,0,1024);mui_canvas_set_draw_color(c,1);
    amiibo_view_on_draw(view,c);frames++;
    mui_canvas_get_clip_window(c,&after);CHECK(!memcmp(&prior,&after,sizeof(prior)));
    CHECK(!memcmp(&before,((amiibo_view_t *)view->user_data)->ntag,sizeof(before)));
}
static void qr_matches(const uint8_t *actual,const uint8_t *reference) {
    same_region(actual,reference,91,25,37,37);qr_checks++;
    for(unsigned y=25;y<62;y++)for(unsigned x=91;x<128;x++)
        if(x<95||x>=124||y<29||y>=58)CHECK(!pixel(actual,x,y));
}
static const char *description(ntag_t *tag) {
    return tag->notes[0] ? (const char *)tag->notes : !linked ? "" : chinese ? descriptions.cn : descriptions.en;
}
static void expected_description(mui_canvas_t *c,ntag_t *tag,unsigned width,unsigned offset) {
    memset(c->fb->tile_buf_ptr,0,1024);mui_canvas_set_draw_color(c,1);
    mui_canvas_set_font(c,u8g2_font_wqy12_t_gb2312a);
    /* Full LCD: bottom nine rows are the persistent middle-button hint.
     * The expected QR continues to be rendered independently at full size. */
    unsigned height=c->height-23;
#ifndef LEGACY_INLINE_NOTES
    if(c->height>=64)height-=9;
#endif
    mui_element_autowrap_text_box(c,0,23,width,height,height,offset,0,description(tag));
#ifndef LEGACY_INLINE_NOTES
    amiibo_active_menu_hint(c,width);
#endif
}

/* Independent row oracle uses the font metrics and explicit line boundaries. */
static unsigned row_pixels(mui_canvas_t *c, const char *row, unsigned y, bool draw_row) {
    unsigned x=0;
    while (*row && *row!='\n') {
        char glyph[5]={0};uint8_t size=mui_canvas_get_utf8_bytes(row);
        memcpy(glyph,row,size);row+=size;
        if (draw_row) mui_canvas_draw_utf8(c,x,y,glyph);
        x+=mui_canvas_get_utf8_width(c,glyph)+1;
    }
    return x ? x-1 : 0;
}
static void expect_wrap(mui_canvas_t *c,mui_canvas_t *reference,unsigned usable,unsigned square,
                        const char *input,const char *rows) {
    memset(c->fb->tile_buf_ptr,0,1024);memset(reference->fb->tile_buf_ptr,0,1024);
    mui_canvas_set_draw_color(c,1);mui_canvas_set_draw_color(reference,1);
    mui_canvas_set_font(c,u8g2_font_wqy12_t_gb2312a);mui_canvas_set_font(reference,u8g2_font_wqy12_t_gb2312a);
    const unsigned step=mui_canvas_current_font_height(c);
    unsigned baseline=step;
    for (;;) {
        row_pixels(reference,rows,baseline,true);
        rows=strchr(rows,'\n');if (!rows) break;
        ++rows;baseline+=step;
    }
    unsigned height=mui_element_autowrap_text_box(c,0,0,usable+4,64,64,0,square,input);
    if(height!=baseline) fprintf(stderr,"wrap height %u expected %u, width %u, inset %u, text %s\n",height,baseline,usable,square,input);
    CHECK(height==baseline);
    same_region(c->fb->tile_buf_ptr,reference->fb->tile_buf_ptr,0,0,128,64);
}

int main(int argc,char **argv) {
    CHECK(argc==3);
    uint8_t buffer[1024],reference[1024],expected[1024],before[1024];
    u8g2_t u,ru,eu;mui_canvas_t canvas,rc,ec;
    setup(&canvas,&u,buffer,64);setup(&rc,&ru,reference,64);setup(&ec,&eu,expected,64);
    amiibo_view_t v;mui_view_t view;ntag_t tag;init_view(&v,&view,&tag);
    char url[AMIIBO_INFO_URL_CAPACITY];CHECK(amiibo_info_url(url,sizeof(url),&tag));
    CHECK(draw_qrcode(&rc,91,25,37,url));
    snprintf((char *)tag.notes,sizeof(tag.notes),"Long own notes with detailed information across several lines; keep this QR visible while scrolling all the description text.");
    if(!strcmp(argv[2],"negative-offset3")) {
        v.desc_offset=3;draw(&canvas,&view);qr_matches(buffer,reference);return 0;
    }
    for(unsigned source=0;source<3;source++)for(unsigned locale=0;locale<2;locale++)for(unsigned ro=0;ro<2;ro++) {
        chinese=locale;tag.read_only=ro;linked=source!=2;
        if(source==0)snprintf((char *)tag.notes,sizeof(tag.notes),"Long own notes with detailed information across several lines; keep this QR visible while scrolling all the description text.");
        else tag.notes[0]=0;
        amiibo_view_reset_desc_scroll(&v);draw(&canvas,&view);qr_matches(buffer,reference);
        unsigned max=amiibo_view_desc_max_offset(&v);
        if(source!=2)CHECK(max>8);else CHECK(max==0);
        unsigned offsets[]={0,1,2,3,8,40,max};
        for(unsigned n=0;n<sizeof(offsets)/sizeof(offsets[0]);n++) {
            unsigned offset=offsets[n];v.desc_offset=offset;
            draw(&canvas,&view);qr_matches(buffer,reference);
            expected_description(&ec,&tag,89,offset);
            same_region(buffer,expected,0,24,89,40);
            for(unsigned y=25;y<64;y++)for(unsigned x=89;x<91;x++)CHECK(!pixel(buffer,x,y));
        }
        if(max) {
            CHECK(v.desc_anim_running && v.desc_anim.time==max*150);
            for(unsigned tick=0;tick<=32;tick++) {
                amiibo_view_desc_anim_exec(&v,(max*tick)/32);
                draw(&canvas,&view);qr_matches(buffer,reference);
            }
        }
        save_frame(argv[1],source==0?(locale?"own_cn":"own_en"):source==1?(locale?"linked_cn":"linked_en"):"no_notes",buffer);
    }
    /* Own notes take precedence even when linked metadata changes. */
    chinese=false;linked=true;snprintf((char *)tag.notes,sizeof(tag.notes),"Own notes remain authoritative for this figure.");
    amiibo_view_reset_desc_scroll(&v);draw(&canvas,&view);memcpy(before,buffer,1024);
    const char *saved_link=descriptions.en;descriptions.en="Different linked metadata must not replace own notes.";
    draw(&canvas,&view);CHECK(!memcmp(before,buffer,1024));descriptions.en=saved_link;
    /* Without QR, the existing full-width description and scrollbar remain. */
    tag.notes[0]=0;settings.qrcode_enabled=false;amiibo_view_reset_desc_scroll(&v);draw(&canvas,&view);
    expected_description(&ec,&tag,128,0);same_region(buffer,expected,0,24,128,40);
    save_frame(argv[1],"qr_disabled",buffer);
    /* Real QR-helper rejection on a shorter canvas restores full text width. */
    settings.qrcode_enabled=true;mui_canvas_set_frame(&canvas,0,0,128,50);mui_canvas_set_frame(&ec,0,0,128,50);
    amiibo_view_reset_desc_scroll(&v);draw(&canvas,&view);expected_description(&ec,&tag,128,0);
    same_region(buffer,expected,0,24,128,26);
    mui_canvas_set_frame(&canvas,0,0,128,64);mui_canvas_set_frame(&ec,0,0,128,64);
    /* Animation setting and manual scrolling keep QR stationary. */
    settings.anim_enabled=false;amiibo_view_reset_desc_scroll(&v);draw(&canvas,&view);CHECK(!v.desc_anim_running);
    qr_matches(buffer,reference);settings.anim_enabled=true;draw(&canvas,&view);CHECK(v.desc_anim_running);
    mui_input_event_t event={INPUT_KEY_RIGHT,INPUT_TYPE_LONG};
    amiibo_view_on_input(&view,&event);CHECK(v.desc_auto_scroll_disabled && !v.desc_anim_running && v.desc_offset==8);
    draw(&canvas,&view);qr_matches(buffer,reference);CHECK(!v.desc_anim_running);
    event.key=INPUT_KEY_LEFT;v.desc_offset=3;amiibo_view_on_input(&view,&event);CHECK(v.desc_offset==0);
    v.desc_offset=1;amiibo_view_on_input(&view,&event);CHECK(v.desc_offset==0);
    v.desc_offset=7;amiibo_view_on_input(&view,&event);CHECK(v.desc_offset==0);
    v.desc_offset=16;amiibo_view_on_input(&view,&event);CHECK(v.desc_offset==8);
    event.key=INPUT_KEY_RIGHT;event.type=INPUT_TYPE_SHORT;amiibo_view_on_input(&view,&event);
    CHECK(v.focus==1 && v.desc_offset==0 && !v.desc_auto_scroll_disabled && slot_events==1);
    draw(&canvas,&view);qr_matches(buffer,reference);CHECK(v.desc_anim_running);
    /* Lines below uint8_t coordinate range must not wrap back onto the screen. */
    unsigned fh=mui_canvas_current_font_height(&canvas);CHECK(fh>0 && fh<20);
    unsigned newlines=(256+32-23-fh)/fh;CHECK(newlines<sizeof(tag.notes)-2);
    memset(tag.notes,'\n',newlines);tag.notes[newlines]='X';tag.notes[newlines+1]=0;
    amiibo_view_reset_desc_scroll(&v);draw(&canvas,&view);qr_matches(buffer,reference);
    for(unsigned y=24;y<55;y++)for(unsigned x=0;x<80;x++)CHECK(!pixel(buffer,x,y));
    unsigned baseline=23+fh+newlines*fh;CHECK(baseline>=256);
    v.desc_offset=baseline-40;draw(&canvas,&view);qr_matches(buffer,reference);
    unsigned dots=0;for(unsigned y=24;y<64;y++)for(unsigned x=0;x<80;x++)dots+=pixel(buffer,x,y);CHECK(dots>0);
    /* Info pages use their dedicated stationary renderer and input path. */
    amiibo_view_on_exit(&view);CHECK(!v.desc_anim_running);v.info_page=2;amiibo_view_on_enter(&view);
    draw(&canvas,&view);memset(expected,0,1024);amiibo_info_draw(&ec,&tag,2);CHECK(!memcmp(buffer,expected,1024));
    v.desc_offset=40;draw(&canvas,&view);CHECK(!memcmp(buffer,expected,1024));
    save_frame(argv[1],"figure_info_qr",buffer);
    event.key=INPUT_KEY_LEFT;event.type=INPUT_TYPE_SHORT;amiibo_view_on_input(&view,&event);CHECK(v.info_page==1);
    event.key=INPUT_KEY_RIGHT;amiibo_view_on_input(&view,&event);CHECK(v.info_page==2);
    event.key=INPUT_KEY_CENTER;amiibo_view_on_input(&view,&event);CHECK(v.info_page==0 && menu_events==1);
    /* The two product-page overrides must keep complete QR symbols stationary
     * alongside the actual scrolling description, including the longer V4 URL. */
    const uint8_t product_ids[2][8]={{0,0,0,4,4,0x43,0x1c,2},{0,0x0a,0,4,4,0x45,0x1c,2}};
    for(unsigned item=0;item<2;item++) {
        memcpy(tag.data+84,product_ids[item],8);
        snprintf((char *)tag.notes,sizeof(tag.notes),"Long product notes remain separate from the complete stationary QR while all pages and animation offsets scroll.");
        CHECK(amiibo_info_url(url,sizeof(url),&tag));
        unsigned box=strlen(url)>53?41:37,left=128-box,top=box==41?23:25;
        memset(reference,0,1024);CHECK(draw_qrcode(&rc,left,top,box,url));
        amiibo_view_reset_desc_scroll(&v);draw(&canvas,&view);
        unsigned max=amiibo_view_desc_max_offset(&v);CHECK(max>8);
        for(unsigned offset=0;offset<=max;offset++) {
            v.desc_offset=offset;draw(&canvas,&view);
            same_region(buffer,reference,left,top,box,box);qr_checks++;
            expected_description(&ec,&tag,left-2,offset);
            same_region(buffer,expected,0,24,left-2,40);
            for(unsigned y=top;y<64;y++)for(unsigned x=left-2;x<left;x++)CHECK(!pixel(buffer,x,y));
        }
        char name[40];snprintf(name,sizeof(name),"product_%u_scroll_qr",item);save_frame(argv[1],name,buffer);
    }
    /* DE3.63: personal notes and game hints stay independently reachable.
     * These are actual C view/input callbacks plus actual u8g2 glyphs/wrapping.
     * No callback may switch a slot while an information page is active. */
    tag.data[84]=tag.data[85]=tag.data[86]=tag.data[87]=0;
    tag.data[88]=tag.data[89]=tag.data[90]=0;tag.data[91]=2;
    strcpy((char *)tag.notes,"Meine eigene Notiz bleibt erhalten.");
    ntag_t saved_tag=tag;unsigned old_slots=slot_events,old_menus=menu_events;
    v.info_page=3;v.focus=1;german=true;chinese=false;linked=true;
    amiibo_view_on_enter(&view);CHECK(v.desc_auto_scroll_disabled && !v.desc_anim_running);
    draw(&canvas,&view);save_frame(argv[1],"de_personal_note",buffer);memcpy(before,buffer,1024);
    descriptions.en="Gerudo-King Fabric";
    draw(&canvas,&view);CHECK(!memcmp(before,buffer,1024));
    event.key=INPUT_KEY_RIGHT;event.type=INPUT_TYPE_SHORT;amiibo_view_on_input(&view,&event);
    CHECK(v.info_page==4 && v.focus==1 && slot_events==old_slots && !v.desc_offset);
    draw(&canvas,&view);save_frame(argv[1],"de_game_hint",buffer);
    memset(expected,0,1024);mui_canvas_set_draw_color(&ec,1);
    mui_element_autowrap_text_box(&ec,0,12,128,29,26,0,0,"Stoff des Gerudo-Königs");
    same_region(buffer,expected,0,14,128,27);
    const char *labels[]={"Deine Notiz","Spielhinweis","L/R: Seite  M: zurück","L/R halten: blättern",
                          "Your note","Game hint","L/R: page  M: back","Hold L/R: scroll"};
    for(unsigned i=0;i<sizeof(labels)/sizeof(labels[0]);i++)
        CHECK(mui_canvas_get_utf8_width(&canvas,labels[i])<=(i<2?100:126));
    const unsigned german_glyphs[]={0x00c4,0x00d6,0x00dc,0x00e4,0x00f6,0x00fc,0x00df};
    for(unsigned i=0;i<sizeof(german_glyphs)/sizeof(german_glyphs[0]);i++)
        CHECK(u8g2_IsGlyph(&u,german_glyphs[i]) && u8g2_GetGlyphWidth(&u,german_glyphs[i])>0);
    descriptions.en="View a particular completed cutscene after beating game without needing 100% completion/Hear a random voice line from Sylux";draw(&canvas,&view);
    unsigned end=amiibo_view_desc_max_offset(&v);CHECK(end>56);
    event.type=INPUT_TYPE_LONG;amiibo_view_on_input(&view,&event);
    CHECK(v.info_page==4 && v.focus==1 && v.desc_offset==mui_canvas_current_font_height(&canvas) && slot_events==old_slots);
    event.type=INPUT_TYPE_REPEAT;
    for(unsigned i=0;i<100;i++)amiibo_view_on_input(&view,&event);
    CHECK(v.desc_offset==end && !v.desc_anim_running);draw(&canvas,&view);
    for(unsigned y=12;y<14;y++)for(unsigned x=0;x<124;x++)CHECK(!pixel(buffer,x,y));
    save_frame(argv[1],"de_game_hint_scrolled_end",buffer);
    event.type=INPUT_TYPE_SHORT;event.key=INPUT_KEY_LEFT;amiibo_view_on_input(&view,&event);
    CHECK(v.info_page==3 && !v.desc_offset && v.desc_auto_scroll_disabled);
    draw(&canvas,&view);same_region(buffer,before,0,0,128,64);
    CHECK(!memcmp(&saved_tag,&tag,sizeof(tag)) && slot_events==old_slots);
    event.key=INPUT_KEY_CENTER;amiibo_view_on_input(&view,&event);
    CHECK(v.info_page==0 && menu_events==old_menus+1 && v.focus==1);
    v.info_page=4;event.type=INPUT_TYPE_LONG;amiibo_view_on_input(&view,&event);
    CHECK(v.info_page==0 && menu_events==old_menus+2 && slot_events==old_slots);
    /* Missing per-game metadata is not a statement of game incompatibility. */
    v.info_page=4;linked=false;amiibo_view_on_enter(&view);draw(&canvas,&view);
    save_frame(argv[1],"de_game_hint_missing",buffer);
    v.info_page=3;tag.notes[0]=0;amiibo_view_on_enter(&view);draw(&canvas,&view);
    save_frame(argv[1],"de_personal_note_empty",buffer);
    /* English remains untouched; unknown English text is an exact fallback. */
    linked=true;v.info_page=4;german=false;descriptions.en="Untranslated catalogue source.";
    amiibo_view_on_enter(&view);draw(&canvas,&view);save_frame(argv[1],"en_game_hint",buffer);
    german=true;draw(&canvas,&view);
    memset(expected,0,1024);mui_canvas_set_draw_color(&ec,1);
    mui_element_autowrap_text_box(&ec,0,12,128,29,26,0,0,descriptions.en);
    same_region(buffer,expected,0,14,128,27);
    /* The first line's accents and the second line's descenders must both
     * survive the info viewport; compare against unclipped real glyphs. */
    v.info_page=3;strcpy((char *)tag.notes,"ÄÖÜäöüß gjpqy\nÄÖÜäöüß gjpqy");
    amiibo_view_on_enter(&view);draw(&canvas,&view);CHECK(v.desc_step==13);
    memset(expected,0,1024);mui_canvas_set_draw_color(&ec,1);
    mui_element_autowrap_text_box(&ec,0,12,128,50,26,0,0,(const char *)tag.notes);
    same_region(buffer,expected,0,14,124,27);
    unsigned accents=0,descenders=0;
    for(unsigned x=0;x<124;x++) {
        for(unsigned y=14;y<19;y++)accents+=pixel(buffer,x,y);
        for(unsigned y=39;y<41;y++)descenders+=pixel(buffer,x,y);
    }
    CHECK(accents && descenders);
    for(unsigned y=12;y<14;y++)for(unsigned x=0;x<124;x++)CHECK(!pixel(buffer,x,y));
    save_frame(argv[1],"de_complete_glyph_lines",buffer);
    expect_wrap(&canvas,&ec,124,0,"Stoff des Gerudo-Königs","Stoff des\nGerudo-Königs");
    expect_wrap(&canvas,&ec,row_pixels(&canvas,"Gerudo-",0,false),0,"Gerudo-Königs","Gerudo-\nKönigs");
    expect_wrap(&canvas,&ec,row_pixels(&canvas,"ÖÖÖ",0,false),0,"ÖÖÖÖÖÖ","ÖÖÖ\nÖÖÖ");
    expect_wrap(&canvas,&ec,row_pixels(&canvas,"ÖÖÖ",0,false),0,"ÖÖÖ   \nß","ÖÖÖ\nß");
    expect_wrap(&canvas,&ec,row_pixels(&canvas,"中文",0,false),0,"中文中文","中文\n中文");
    expect_wrap(&canvas,&ec,124,0,"ÄÖÜäöüß\n\ngjpqy\n","ÄÖÜäöüß\n\ngjpqy\n");
    unsigned full=row_pixels(&canvas,"WW",0,false);
    expect_wrap(&canvas,&ec,full,3,"WW WW","W\nW\nWW");

    /* Keep logical scroll pages and indicator pages in agreement even when
     * the glyph clip is taller to preserve descenders. This fails on App636. */
    v.info_page=3;german=true;
    strcpy((char *)tag.notes,"Zeile eins\nZeile zwei\nZeile drei");
    amiibo_view_on_enter(&view);draw(&canvas,&view);
    CHECK(v.desc_total==39 && v.desc_page_size==26 && v.desc_step==13);
    unsigned first_thumb=255,last_thumb=255;
    for(unsigned y=12;y<41;y++)if(pixel(buffer,125,y)){first_thumb=y;break;}
    save_frame(argv[1],"scrollbar_regression_first",buffer);
    event.key=INPUT_KEY_RIGHT;event.type=INPUT_TYPE_LONG;
    amiibo_view_on_input(&view,&event);draw(&canvas,&view);CHECK(v.desc_offset==13);
    save_frame(argv[1],"scrollbar_regression_intermediate",buffer);
    event.type=INPUT_TYPE_REPEAT;amiibo_view_on_input(&view,&event);draw(&canvas,&view);
    CHECK(v.desc_offset==26 && v.desc_offset==amiibo_view_desc_max_offset(&v));
    for(unsigned y=12;y<41;y++)if(pixel(buffer,125,y)){last_thumb=y;break;}
    save_frame(argv[1],"scrollbar_regression_final",buffer);
    CHECK(first_thumb==12 && last_thumb==26 && last_thumb>first_thumb);

    /* Compare the shipped German text to independently supplied reviewed strings
     * in every note viewport and again in the narrower view beside the QR. */
    settings.qrcode_enabled=true;german=true;chinese=false;linked=true;tag.notes[0]=0;
    CHECK(amiibo_info_url(url,sizeof(url),&tag));
    memset(reference,0,sizeof(reference));CHECK(draw_qrcode(&rc,91,25,37,url));
    unsigned page_checks=0, bottom_checks=0;
    for(size_t i=0;i<sizeof(expected_notes)/sizeof(expected_notes[0]);++i) {
        const char *en=expected_notes[i].en,*de=expected_notes[i].de;
        descriptions.en=en;v.info_page=4;amiibo_view_on_enter(&view);
        for(unsigned page=0;;++page) {
            CHECK(page<64);draw(&canvas,&view);
            memset(expected,0,sizeof(expected));
            mui_canvas_set_draw_color(&ec,1);
            unsigned expected_total=mui_element_autowrap_text_box(&ec,0,12,128,29,26,v.desc_offset,0,de);
            CHECK(v.desc_total==expected_total);
            same_region(buffer,expected,0,14,124,27);
            ++page_checks;
            if(v.desc_offset==amiibo_view_desc_max_offset(&v)) {
                if(v.desc_total>v.desc_page_size) {CHECK(pixel(buffer,125,40));++bottom_checks;}
                break;
            }
            unsigned prior_offset=v.desc_offset;
            event.key=INPUT_KEY_RIGHT;event.type=INPUT_TYPE_REPEAT;
            amiibo_view_on_input(&view,&event);CHECK(v.desc_offset>prior_offset);
        }
        v.info_page=0;amiibo_view_on_enter(&view);draw(&canvas,&view);
        qr_matches(buffer,reference);
        descriptions.en=de;expected_description(&ec,&tag,89,0);
        same_region(buffer,expected,0,24,89,40);
    }
    CHECK(bottom_checks>0);
    printf("PASS DE3.67 reviewed note pixels: %zu strings, %u scroll positions, %u nontrivial final pages and %zu complete adjacent QR checks.\n",
           sizeof(expected_notes)/sizeof(expected_notes[0]),page_checks,bottom_checks,sizeof(expected_notes)/sizeof(expected_notes[0]));
    printf("PASS amiidb QR: %u real framebuffer frames, %u complete QR comparisons; notes/links/locales/readonly/off/failure/manual/animation/info/long-lines\n",frames,qr_checks);
    return 0;
}
