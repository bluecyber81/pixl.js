extern const char *const lang_de_DE[];
extern const char *const lang_en_US[];
static bool english;
const char *getLangString(int id) { return (english ? lang_en_US : lang_de_DE)[id]; }
const db_amiibo_t *get_amiibo_by_id(uint32_t h,uint32_t t) {
    static const db_amiibo_t known = {0};
    return (h==0 && t==2) || (h==0x1f030100 && t==0x04c91e03) ? &known : NULL;
}
