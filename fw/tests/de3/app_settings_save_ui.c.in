static void reset_fixture(test_app_t *app, mui_list_view_t *list, mui_msg_box_t *box, unsigned view) {
    memset(&ram, 0, sizeof(ram)); disk = discard_base = ram;
    save_generation = edited_fields = 0; m_recovered = NULL; commit_before_error = false;
    memset(&detail_view, 0, sizeof(detail_view));
    saves = previous = next_scene = toasts = warnings = saved_logs = clears = no_key = 0;
    save_result = 0; key_loaded = true; shown = view;
    memset(app, 0, sizeof(*app)); memset(list, 0, sizeof(*list)); memset(box, 0, sizeof(*box));
    list->user_data = app; list->rows = 8; box->user_data = app;
    app->p_list_view = list; app->p_msg_box = box;
    app->p_amiibo_detail_view = app->p_amiibo_view = &detail_view;
}
static void check_save_error(mui_msg_box_t *box, unsigned view) {
    assert(shown == (int)view && previous == 0 && box->event_cb);
    assert(!strcmp(box->header, "DE3_SAVE_FAILED") && !strcmp(box->message, "DE3_SAVE_RAM_ONLY"));
    assert(!strcmp(box->left, "DE3_SAVE_RETRY_ACTION"));
    assert(!strcmp(box->center, "DE3_SAVE_DISCARD_ACTION"));
    assert(!strcmp(box->right, "BACK") && box->focus == MUI_MSG_BOX_EVENT_SELECT_RIGHT);
}

static void check_discard_question(mui_msg_box_t *box, unsigned view) {
    assert(shown == (int)view && box->event_cb);
    assert(!strcmp(box->message, "DE3_SAVE_DISCARD_ASK"));
    assert(!strcmp(box->left, "DE3_SAVE_YES_SHORT") && !box->center);
    assert(!strcmp(box->right, "DE3_SAVE_NO_SHORT") && box->focus == MUI_MSG_BOX_EVENT_SELECT_RIGHT);
}
