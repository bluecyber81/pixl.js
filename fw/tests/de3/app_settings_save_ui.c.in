typedef struct { int dummy; } db_amiibo_t;
typedef struct {
    mui_list_view_t *p_list_view;
    mui_msg_box_t *p_msg_box;
    mui_text_input_t *p_text_input;
    void *p_toast_view, *p_view_dispatcher, *p_scene_dispatcher;
    amiibo_detail_view_t *p_amiibo_detail_view;
    amiibo_view_t *p_amiibo_view;
    ntag_t ntag;
    bool focus_detail_file;
    unsigned cur_slot_index, prev_scene_id;
    const char *current_file;
    int amiibolink_mode;
} test_app_t;
typedef test_app_t app_amiibo_t;
typedef test_app_t app_amiidb_t;
typedef test_app_t app_amiibolink_t;
typedef struct {
    bool auto_gen_amiibo, qrcode_enabled;
    uint8_t amiibolink_mode, amiidb_sort_column, amiidb_data_slot_num;
    uint8_t unrelated;
} settings_data_t;
/* SETTINGS_CHECKPOINT_TYPES */
static settings_data_t ram, disk, discard_base;
#define m_settings_data ram
static uint32_t save_generation, edited_fields;
static void (*m_recovered)(const settings_data_t *previous);
/* SETTINGS_CHECKPOINT_FUNCTIONS */
static int save_result, saves, previous, next_scene, shown, toasts, warnings, saved_logs, clears, no_key;
static bool key_loaded = true, commit_before_error;
static amiibo_detail_view_t detail_view;
static settings_data_t *settings_get_data(void) { return &ram; }
#define SETTINGS_FIELD_MASK(field) (UINT32_C(1) << offsetof(settings_data_t, field))
#define SETTINGS_TOGGLE(field) settings_toggle_byte(offsetof(settings_data_t, field))
#define SETTINGS_SET(field, value) settings_set_byte(offsetof(settings_data_t, field), (value))
#define SETTINGS_CHECKPOINT(field, checkpoint) settings_checkpoint_byte(offsetof(settings_data_t, field), (checkpoint))
#define SETTINGS_DISCARD(field, checkpoint) settings_discard_byte(offsetof(settings_data_t, field), (checkpoint))
static int settings_save(void) {
    saves++;
    if (!save_result || commit_before_error) disk = ram;
    if (!save_result) { discard_base = ram; save_generation++; edited_fields = 0; }
    return save_result;
}
#define NRF_LOG_INFO(...) ((void)saved_logs++)
#define NRF_LOG_WARNING(...) ((void)warnings++)
