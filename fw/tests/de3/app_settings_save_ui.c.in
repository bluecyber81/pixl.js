static const char *fixture_text(const char *name) { return name; }
#define _T(x) fixture_text(#x)
/* Use short labels for formatting-only dependencies; ON/OFF remain distinct. */
static const char *fixture_language(const char *name) {
    return !strcmp(name, "_L_ON_F") || !strcmp(name, "_L_OFF_F") ? name : "Label";
}
#define getLangString(x) fixture_language(#x)
#define string_get_cstr(x) (x)
