struct mui_msg_box_s {
    void *user_data;
    mui_msg_box_event_cb_t event_cb;
    const char *header, *message, *left, *center, *right;
    unsigned focus;
};
struct mui_list_view_s { void *user_data; mui_list_view_selected_cb selected_cb; unsigned rows; };
struct mui_list_item_s { int icon; void *user_data; char sub_text[64]; };
