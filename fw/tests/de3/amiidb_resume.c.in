static void fill_tag(ntag_t *tag,uint8_t pattern,uint32_t head,uint32_t tail){
 memset(tag,pattern,sizeof(*tag));tag->type=NTAG_215;tag->read_only=true;
 for(unsigned n=0;n<4;n++){tag->data[84+n]=(uint8_t)(head>>(24-8*n));tag->data[88+n]=(uint8_t)(tail>>(24-8*n));}
}
