static uint32_t crc32_compute(const uint8_t*p,size_t n,const uint32_t*previous){
 uint32_t crc=previous?~*previous:~0u;while(n--){crc^=*p++;for(unsigned b=0;b<8;b++)crc=(crc>>1)^((0u-(crc&1u))&0xedb88320u);}return ~crc;
}
