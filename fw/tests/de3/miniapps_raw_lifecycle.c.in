/* Actual temporary advertiser implementation with a strict SoftDevice model. */
#include <assert.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "switch2_protocol.h"
#define NRF_SDH_BLE_OBSERVER(...)
#define APP_BLE_CONN_CFG_TAG 1
#define BLE_GAP_ADV_INTERVAL_MIN 32
#define BLE_GAP_PHY_1MBPS 1
#define BLE_GAP_ADV_FP_ANY 0
#define BLE_GAP_ADDR_TYPE_PUBLIC 0
#define BLE_GAP_TX_POWER_ROLE_ADV 1
#define BLE_GAP_ADV_TYPE_CONNECTABLE_SCANNABLE_UNDIRECTED 1
#define BLE_GAP_ADV_TYPE_NONCONNECTABLE_NONSCANNABLE_UNDIRECTED 3
#define BLE_GAP_EVT_CONNECTED 10
#define BLE_GAP_EVT_ADV_SET_TERMINATED 11
enum {NRF_SUCCESS,NRF_ERROR_BUSY,NRF_ERROR_INVALID_PARAM,NRF_ERROR_NO_MEM,NRF_ERROR_INTERNAL,NRF_ERROR_INVALID_STATE};
typedef struct {uint8_t addr_type,addr[6];}ble_gap_addr_t;
typedef struct {struct {uint8_t*p_data;uint16_t len;}adv_data,scan_rsp_data;}ble_gap_adv_data_t;
typedef struct {struct{uint8_t type;}properties;uint8_t filter_policy,primary_phy;uint16_t interval,duration;}ble_gap_adv_params_t;
typedef struct {struct{unsigned evt_id;}header;struct{struct{struct{struct{uint8_t adv_handle;}adv_set_terminated;}params;}gap_evt;}evt;}ble_evt_t;
typedef void(*ble_raw_adv_done_cb_t)(uint32_t);
static struct {bool initialized;uint8_t adv_handle;}m_advertising;
static bool m_remote_mode;
static bool scan_busy,mode_pending,idle=true,no_memory,radio_running;
static unsigned allocations,frees,callbacks,irq,feed;
static int tx_power;
static ble_gap_addr_t address,original;
static const uint8_t*sdk_pointer;
static ble_gap_adv_params_t last_params;
static const char*fail_stage;
static bool failed;
static bool fail(const char*s){assert(!irq);if(fail_stage&&!failed&&!strcmp(fail_stage,s)){failed=true;return true;}return false;}
static void*mui_mem_malloc(size_t n){assert(!irq);if(no_memory)return NULL;void*p=malloc(n);assert(p);allocations++;return p;}
static void mui_mem_free(void*p){assert(!irq&&p&&!sdk_pointer);frees++;free(p);}
static bool ble_switch2_scan_is_active(void){return scan_busy;}
static bool ble_mode_transition_pending(void){return mode_pending;}
static bool ble_transport_idle(void){return idle;}
static void ble_init(void){assert(!irq);}
static void ble_disable(void){assert(!irq);idle=false;}
static void nrf_pwr_mgmt_feed(void){assert(!irq);feed++;}
static uint32_t sd_ble_gap_addr_get(ble_gap_addr_t*p){if(fail("get"))return NRF_ERROR_INTERNAL;*p=address;return 0;}
static uint32_t sd_ble_gap_addr_set(const ble_gap_addr_t*p){bool restore=!memcmp(p,&original,sizeof original);if(fail(restore?"restoreAddress":"setAddress"))return NRF_ERROR_INTERNAL;assert(!radio_running);address=*p;return 0;}
static uint32_t advertising_init(bool remote){assert(remote==m_remote_mode||!m_advertising.initialized);if(fail(sdk_pointer?"restoreData":"init"))return NRF_ERROR_INTERNAL;sdk_pointer=NULL;m_advertising.initialized=true;m_advertising.adv_handle=5;return 0;}
static uint32_t sd_ble_gap_adv_set_configure(uint8_t*h,const ble_gap_adv_data_t*d,const ble_gap_adv_params_t*p){if(fail("configure"))return NRF_ERROR_INTERNAL;assert(*h==5&&d->adv_data.len==31&&d->adv_data.p_data&&!d->scan_rsp_data.p_data&&!d->scan_rsp_data.len);sdk_pointer=d->adv_data.p_data;last_params=*p;return 0;}
static uint32_t sd_ble_gap_tx_power_set(unsigned role,uint8_t handle,int power){assert(role==1&&handle==5);if(fail(power?"tx4":"restorePower"))return NRF_ERROR_INTERNAL;tx_power=power;return 0;}
static uint32_t sd_ble_gap_adv_start(uint8_t handle,unsigned tag){assert(handle==5&&tag==1&&sdk_pointer);if(fail("start"))return NRF_ERROR_INTERNAL;radio_running=true;return 0;}
static uint32_t sd_ble_gap_adv_stop(uint8_t handle){assert(handle==5);if(fail("stop"))return NRF_ERROR_BUSY;if(!radio_running)return NRF_ERROR_INVALID_STATE;radio_running=false;return 0;}
/* ACTUAL_RAW_ADVERTISER */
static unsigned checks;
#define CHECK(x) do{assert(x);checks++;}while(0)
static void done(uint32_t result){assert(!irq);CHECK(result==0&&!m_raw_adv&&!sdk_pointer&&tx_power==0&&!memcmp(&address,&original,sizeof address));callbacks++;}
static const uint8_t controller[6]={0x11,0x22,0x33,0x44,0x55,0x66};
static uint8_t payload[31];
static void process(void){ble_raw_adv_process();}
static void reset(void){
 CHECK(!m_raw_adv&&allocations==frees&&!sdk_pointer);scan_busy=mode_pending=no_memory=radio_running=false;idle=true;tx_power=0;fail_stage=NULL;failed=false;callbacks=0;
 m_advertising.initialized=true;m_advertising.adv_handle=5;m_remote_mode=false;
 original=(ble_gap_addr_t){.addr_type=1,.addr={9,8,7,6,5,4}};address=original;
}
static void event(unsigned id){ble_evt_t e={0};e.header.evt_id=id;e.evt.gap_evt.params.adv_set_terminated.adv_handle=5;radio_running=false;irq++;ble_raw_adv_observer(&e,NULL);irq--;}
static void drain(void){idle=true;process();CHECK(!m_raw_adv&&allocations==frees&&!sdk_pointer);}
int main(void){
 reset();
 CHECK(ble_raw_adv_start(NULL,payload,31,false,200,done)==NRF_ERROR_INVALID_PARAM);
 CHECK(ble_raw_adv_start(controller,NULL,31,false,200,done)==NRF_ERROR_INVALID_PARAM);
 CHECK(ble_raw_adv_start(controller,payload,30,false,200,done)==NRF_ERROR_INVALID_PARAM);
 CHECK(ble_raw_adv_start(controller,payload,31,false,0,done)==NRF_ERROR_INVALID_PARAM);
 CHECK(ble_raw_adv_start(controller,payload,31,false,301,done)==NRF_ERROR_INVALID_PARAM);
 for(unsigned n=0;n<3;n++){scan_busy=n==0;mode_pending=n==1;idle=n!=2;CHECK(ble_raw_adv_start(controller,payload,31,false,200,done)==NRF_ERROR_BUSY);CHECK(!m_raw_adv&&!allocations);}reset();
 no_memory=true;CHECK(ble_raw_adv_start(controller,payload,31,false,200,done)==NRF_ERROR_NO_MEM);CHECK(!m_raw_adv);reset();
 for(unsigned connectable=0;connectable<2;connectable++){
  m_remote_mode=connectable;original.addr_type=connectable;address=original;
  CHECK(ble_raw_adv_start(controller,payload,31,connectable,200,done)==0);CHECK(ble_miniapp_radio_busy()&&sdk_pointer&&tx_power==4&&radio_running);
  CHECK(last_params.interval==32&&last_params.duration==200&&last_params.primary_phy==1&&last_params.filter_policy==0);
  CHECK(last_params.properties.type==(connectable?1:3));for(unsigned i=0;i<6;i++)CHECK(address.addr[i]==controller[5-i]);CHECK(address.addr_type==0);
  CHECK(ble_raw_adv_start(controller,payload,31,false,200,done)==NRF_ERROR_BUSY);
  event(connectable?BLE_GAP_EVT_CONNECTED:BLE_GAP_EVT_ADV_SET_TERMINATED);process();CHECK(m_raw_adv&&!callbacks&&sdk_pointer);drain();CHECK(callbacks==1);reset();
 }
 /* Every start failure restores only resources that were actually acquired. */
 const char*starts[]={"get","init","setAddress","configure","tx4","start"};
 for(unsigned i=0;i<sizeof starts/sizeof starts[0];i++){
  reset();fail_stage=starts[i];if(!strcmp(fail_stage,"init"))m_advertising.initialized=false;
  CHECK(ble_raw_adv_start(controller,payload,31,false,200,done)==NRF_ERROR_INTERNAL);CHECK(failed&&m_raw_adv&&!callbacks);drain();CHECK(!memcmp(&address,&original,sizeof address)&&tx_power==0&&!callbacks);
 }
 reset();
 /* Pending restore failures retain all borrowed storage for a retry. */
 const char*restores[]={"stop","restoreData","restorePower","restoreAddress"};
 for(unsigned i=0;i<sizeof restores/sizeof restores[0];i++){
  reset();CHECK(ble_raw_adv_start(controller,payload,31,false,200,done)==0);event(BLE_GAP_EVT_ADV_SET_TERMINATED);idle=true;fail_stage=restores[i];process();CHECK(failed&&m_raw_adv&&!callbacks&&allocations==frees+1);process();CHECK(!m_raw_adv&&callbacks==1&&allocations==frees);
 }
 reset();CHECK(ble_raw_adv_start(controller,payload,31,false,200,done)==0);ble_raw_adv_stop();CHECK(m_raw_adv&&!callbacks&&!radio_running);drain();CHECK(!callbacks);reset();
 /* Irrelevant events and a different advertiser never complete this owner. */
 CHECK(ble_raw_adv_start(controller,payload,31,false,200,done)==0);ble_evt_t e={0};e.header.evt_id=BLE_GAP_EVT_ADV_SET_TERMINATED;e.evt.gap_evt.params.adv_set_terminated.adv_handle=9;ble_raw_adv_observer(&e,NULL);idle=true;process();CHECK(m_raw_adv&&m_raw_adv->active);ble_raw_adv_stop();drain();reset();
 printf("PASS %u raw advertiser lifecycle assertions; temporary data/MAC ownership, mocked SoftDevice\n",checks);
 return 0;
}
