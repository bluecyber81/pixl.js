typedef struct {
    list_t *p_list_view;
    mui_msg_box_t *p_msg_box;
    mui_view_dispatcher_t *p_view_dispatcher;
    void *p_scene_dispatcher, *p_view_dispatcher_toast, *p_toast_view, *p_progress_bar;
    bool exit_saved, exit_discard, confirm_discard, storage_snapshot;
    settings_checkpoint_t entry_settings;
    uint32_t changed_fields;
    uint16_t changed_apps;
} app_settings_t;
enum { SETTINGS_VIEW_ID_MAIN, SETTINGS_VIEW_ID_MSG_BOX };
enum { MUI_MSG_BOX_EVENT_SELECT_LEFT, MUI_MSG_BOX_EVENT_SELECT_CENTER, MUI_MSG_BOX_EVENT_SELECT_RIGHT };
