enum { MUI_LAYER_FULLSCREEN, MUI_LAYER_TOAST, INPUT_TYPE_SHORT };
typedef unsigned mini_app_exit_reason_t;
typedef struct mini_app_inst_s mini_app_inst_t;
typedef struct {
    unsigned id; bool sys;
    void (*kill_cb)(mini_app_inst_t *);
    bool (*prepare_exit_cb)(mini_app_inst_t *, mini_app_exit_reason_t);
    void (*cancel_exit_cb)(mini_app_inst_t *);
} mini_app_t;
struct mini_app_inst_s { mini_app_inst_t *next; const mini_app_t *p_app; void *p_handle; unsigned state; };
typedef struct {
    mini_app_inst_t *instances, *p_main_app_inst, *prepared_inst;
    void *prepared_handle;
    bool exit_busy, exit_prepared;
    mini_app_exit_reason_t exit_reason;
} mini_app_launcher_t;
static list_t list;
static mui_msg_box_t dialog;
static mui_view_dispatcher_t views;
static app_settings_t menu = {.p_list_view = &list, .p_msg_box = &dialog, .p_view_dispatcher = &views};
static unsigned visible_view, kills, cleanup_calls, nfc_checks, nfc_cancels, runtime_restores;
static bool nfc_veto, owner_veto;
static const char *message;
static void (*acknowledge)(mui_msg_box_event_t, mui_msg_box_t *);
static bool ntag_emu_prepare_change(void) { nfc_checks++; return !nfc_veto; }
static void ntag_emu_cancel_change(void) { nfc_cancels++; }
static void mui_input_context_changed(void) {}
static void mini_app_launcher_run(mini_app_launcher_t *launcher,unsigned id) { assert(id==MINI_APP_ID_DESKTOP); kills++; }
static void cleanup(void *p) { (void)p; cleanup_calls++; }
