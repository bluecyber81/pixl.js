@KILL@
@LAUNCHER@
static bool owner_guard(mini_app_inst_t *inst,mini_app_exit_reason_t reason) { return !owner_veto; }
static mini_app_t fixture_app = {.id=MINI_APP_ID_SETTINGS,.kill_cb=app_settings_on_kill,.prepare_exit_cb=owner_guard};
static mini_app_inst_t instance;
/* The MsgBox component separately tests gesture/focus/frame fencing. Here an
 * explicitly selected visible button enters the real view dispatcher and the
 * unchanged Settings callback, launcher guards and accepted kill callback. */
static void selected_button(mui_view_t *view,mui_input_event_t *event) {
    mui_msg_box_t *box=view->user_data; assert(box->event_cb); box->event_cb(event->choice,box);
}
static mui_view_t box_view = {.user_data=&dialog,.input_cb=selected_button};
static void press_button(unsigned choice) {
    assert(views.p_active_view==&box_view);
    mui_view_port_t port={.user_data=&views};mui_input_event_t event={.choice=choice};
    mui_view_dispatcher_on_input(&port,&event);
}
static void start_menu(void) {
    menu=(app_settings_t){.p_list_view=&list,.p_msg_box=&dialog,.p_view_dispatcher=&views};
    dialog.user_data=&menu;
    settings_checkpoint(&menu.entry_settings);
    instance=(mini_app_inst_t){.p_app=&fixture_app,.p_handle=&menu,.state=APP_STATE_RUNNING};
    *mini_app_launcher()=(mini_app_launcher_t){.instances=&instance,.p_main_app_inst=&instance};
    nfc_veto=owner_veto=false;kills=cleanup_calls=nfc_checks=nfc_cancels=0;
}
#define mui_list_view_get_scroll_offset(v) ((v)->scroll)
