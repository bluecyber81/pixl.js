#include <assert.h>
#include <stdio.h>
#include <string.h>
#include "mui_view.h"
#include "mui_contrast.h"
#define BOARD_OLED 1
#define PIXL_RUNTIME_DIAGNOSTICS 1

enum { LANGUAGE_DE_DE, LANGUAGE_EN_US };
enum { SETTINGS_VIEW_ID_MAIN, SETTINGS_VIEW_ID_DEVICE_TEST };
typedef struct {
    void *p_view_dispatcher, *p_view_dispatcher_toast, *p_scene_dispatcher;
    void *p_list_view, *p_progress_bar, *p_msg_box, *p_toast_view;
    bool exit_saved;
    mui_view_t device_test;
    uint8_t tested_keys, held_keys, released_keys, contrast_saved, contrast_target;
    bool contrast_active;
} app_settings_t;
typedef struct { app_settings_t *p_handle; } mini_app_inst_t;
static struct { uint8_t oled_contrast; } saved_settings = {65};
static void *settings_get_data(void);
#define settings_get_data() (&saved_settings)
static unsigned actual_contrast = 65, contrast_writes, cleanup_calls, save_calls;
static void mui_u8g2_set_contrast_level(uint8_t value) { actual_contrast = value; contrast_writes++; }
static void cleanup(void *p) { (void)p; assert(actual_contrast == saved_settings.oled_contrast); cleanup_calls++; }
#define mui_scene_dispatcher_free cleanup
#define mui_view_dispatcher_free cleanup
#define mui_list_view_free cleanup
#define mui_progress_bar_free cleanup
#define mui_msg_box_free cleanup
#define mui_toast_view_free cleanup
#define mui_mem_free cleanup
#define MUI_LAYER_FULLSCREEN 0
#define MUI_LAYER_TOAST 1
#define NRF_SUCCESS 0
#define NRF_LOG_WARNING(...) ((void)0)
static void mui_nav_diag_end(void) {}
static int32_t settings_save(void) { assert(actual_contrast == saved_settings.oled_contrast); save_calls++; return 0; }
static void mui_view_dispatcher_detach(void *p, unsigned layer) { (void)layer; cleanup(p); }
static unsigned language, active, lines;
enum { BLE_LINK_INACTIVE, BLE_LINK_ADVERTISING, BLE_LINK_CONNECTED, BLE_LINK_HOST_CONNECTED, BLE_LINK_DISCONNECTING };
static bool permission, remote_mode, transitioning;
static unsigned link_state;
enum { BLE_REMOTE_INIT_IDLE, BLE_REMOTE_INIT_WAIT, BLE_REMOTE_INIT_ADDRESS, BLE_REMOTE_INIT_NAME,
       BLE_REMOTE_INIT_MTU, BLE_REMOTE_INIT_ADVDATA, BLE_REMOTE_INIT_START, BLE_REMOTE_INIT_READY };
static uint8_t init_phase;
static uint32_t init_result;
static uint8_t ble_remote_init_phase(void) { return init_phase; }
static uint32_t ble_remote_init_result(void) { return init_result; }
static bool ble_remote_enabled(void) { return permission; }
static bool ble_remote_mode_active(void) { return remote_mode; }
static bool ble_mode_transition_pending(void) { return transitioning; }
static unsigned ble_status_state_get(void) { return link_state; }
static const char *status, *hint;
static mui_view_t *registered;
static int getLanguage(void) { return language; }
static const char *version_get_source_id(void) { return "abcdef0123459876"; }
static void mui_view_dispatcher_add_view(void *d, unsigned id, mui_view_t *v) {
    assert(d && id == SETTINGS_VIEW_ID_DEVICE_TEST); registered = v;
}
static void mui_view_dispatcher_switch_to_view(void *d, unsigned id) {
    assert(d);
    if (active == SETTINGS_VIEW_ID_DEVICE_TEST && registered->exit_cb) registered->exit_cb(registered);
    active = id;
}

static uint8_t checked_text(mui_canvas_t *c, uint8_t x, uint8_t y, const char *text) {
    app_settings_t *app = registered->user_data;
    const char *expected[] = {"OLED / SH1106", "ID abcdef012345", status, language ? "Left" : "Links",
                              language ? "Center" : "Mitte", language ? "Right" : "Rechts", hint};
    if (app->contrast_active) {
        char target[28];
        snprintf(target, sizeof(target), "%s %u%% / 0x%02X", language ? "Target" : "Soll",
                 app->contrast_target, mui_contrast_raw(app->contrast_target));
        const char *contrast[] = {language ? "Contrast test" : "Kontrasttest", target,
            language ? "L: Dim  R: Bright" : "L: Dunkel  R: Hell",
            language ? "Center:info; hold:back" : "Mitte:Info; lang:Ende"};
        assert(lines < 4 && !strcmp(text, contrast[lines++]));
    } else {
        assert(lines < sizeof(expected)/sizeof(*expected));
        if (strcmp(text,expected[lines])) fprintf(stderr,"line %u got [%s] expected [%s]\n",lines,text,expected[lines]);
        assert(!strcmp(text, expected[lines++]));
    }
    unsigned end = !app->contrast_active && y == 11 ? 101 : y == 47 ? x+39 : 127;
    if (x+mui_canvas_get_utf8_width(c,text) >= end) fprintf(stderr,"overflow [%s] %u at %u\n",text,mui_canvas_get_utf8_width(c,text),x);
    assert(x > 0 && x+mui_canvas_get_utf8_width(c, text) < end);
    return mui_canvas_draw_utf8(c, x, y, text);
}
#define mui_canvas_draw_utf8 checked_text
/* PRODUCTION */
#undef mui_canvas_draw_utf8

static uint8_t pixels[1024];
static unsigned rotated;
static unsigned pixel(unsigned x, unsigned y) {
    if (rotated) { x = 127 - x; y = 63 - y; }
    return (pixels[(y/8)*128+x] >> (y%8)) & 1;
}
static void draw(mui_canvas_t *c) {
    memset(pixels, 0, sizeof(pixels)); lines = 0;
    assert(active == SETTINGS_VIEW_ID_DEVICE_TEST);
    registered->draw_cb(registered, c);
    bool contrast = ((app_settings_t *)registered->user_data)->contrast_active;
    assert(lines == (contrast ? 4 : 7));
    for (unsigned x=0; x<128; ++x) assert(pixel(x,0) && pixel(x,63));
    for (unsigned y=0; y<64; ++y) assert(pixel(0,y) && pixel(127,y));
    if (contrast) return;
    for (unsigned x=101; x<107; ++x) assert(pixel(x,6) == (x%2));
    for (unsigned y=0; y<8; ++y)
        for (unsigned x=0; x<8; ++x)
            assert(pixel(107+x,4+y) == ((x+y)%2 == 0));
    for (unsigned y=0; y<7; ++y) {
        for (unsigned x=0; x<5; ++x) {
            unsigned mark = (y==1 && x>=1 && x<=3) || (x==2 && y>=2 && y<=5);
            assert(pixel(115+x,4+y)==mark && pixel(120+x,4+y)==!mark);
        }
    }
    for (unsigned y=1; y<=3; ++y)
        for (unsigned x=1; x<=3; ++x) {
            assert(pixel(x,y)==(y==1));
            assert(pixel(127-x,y)==(x==1));
            assert(pixel(127-x,63-y)==(x<=2 && y<=2));
            assert(pixel(x,63-y)==(x==1 && y==1));
        }
    assert(mui_canvas_get_draw_color(c)==1);
}
static void input(input_key_t key, input_type_t type) {
    mui_input_event_t event = {.key=key, .type=type}; registered->input_cb(registered, &event);
}
static void click(input_key_t key) {
    input(key,INPUT_TYPE_PRESS); input(key,INPUT_TYPE_RELEASE); input(key,INPUT_TYPE_SHORT);
}

int main(void) {
    static const u8x8_display_info_t display = {.tile_width=16,.tile_height=8,.pixel_width=128,.pixel_height=64};
    u8g2_t u = {0}; mui_canvas_t c = {.fb=&u}; app_settings_t app = {.p_view_dispatcher=&app};
    u.u8x8.display_info = &display;
    u8g2_SetupBuffer(&u, pixels, 8, u8g2_ll_hvline_vertical_top_lsb, U8G2_R0);
    mui_canvas_set_frame(&c,0,0,128,64);
    for (rotated=0; rotated<2; ++rotated) for (language=0; language<2; ++language) {
        u8g2_SetDisplayRotation(&u,rotated ? U8G2_R2 : U8G2_R0);
        permission = remote_mode = transitioning = false;
        link_state = BLE_LINK_CONNECTED;
        status = language ? "Remote: off" : "Remote: aus";
        hint = language ? "Center:test; hold:back" : "Mitte:Test; lang:Ende";
        settings_device_test_open(&app); draw(&c);
        assert(registered == &app.device_test && !app.held_keys && !app.tested_keys);
        mui_canvas_set_font(&c,MUI_FONT_NORMAL); assert(u8g2_IsGlyph(&u,0xfc));
        input(INPUT_KEY_CENTER, INPUT_TYPE_RELEASE);
        input(INPUT_KEY_CENTER, INPUT_TYPE_SHORT);
        assert(!app.held_keys && !app.tested_keys);
        for (unsigned k=0; k<3; ++k) {
            unsigned x = 4+41*k;
            assert(!pixel(x,49)); input(k, INPUT_TYPE_PRESS); draw(&c);
            assert(pixel(x,49) && pixel(x+31,51) && !pixel(x+32,51));
            input(k, INPUT_TYPE_RELEASE); draw(&c);
            assert(pixel(x,49) && !pixel(x,51));
        }
        input(INPUT_KEY_LEFT, INPUT_TYPE_LONG); input(INPUT_KEY_RIGHT, INPUT_TYPE_REPEAT);
        assert(app.tested_keys == 7 && !app.held_keys && active == SETTINGS_VIEW_ID_DEVICE_TEST);
        permission = true;
        status = language ? "Remote: waiting" : "Remote: wartet"; draw(&c);
        remote_mode = transitioning = true; draw(&c);
        transitioning = false;
        const char *de_states[] = {"Remote: inaktiv", "BLE: Pixl.Remote", "Remote: verbunden", "Remote: nur Link", "Remote: trennt"};
        const char *en_states[] = {"Remote: idle", "BLE: Pixl.Remote", "Remote: connected", "Remote: link only", "Remote: closing"};
        for (link_state = BLE_LINK_INACTIVE; link_state <= BLE_LINK_DISCONNECTING; ++link_state) {
            status = language ? en_states[link_state] : de_states[link_state];
            draw(&c);
        }
        init_phase = BLE_REMOTE_INIT_NAME; init_result = 17;
        status = "BLE 3/00000011"; draw(&c);
        init_phase = BLE_REMOTE_INIT_START; init_result = 0xffffffff;
        status = "BLE 6/FFFFFFFF"; draw(&c);
        init_phase = BLE_REMOTE_INIT_READY; init_result = 0;
        link_state = BLE_LINK_DISCONNECTING;
        status = language ? "Remote: closing" : "Remote: trennt";

        click(INPUT_KEY_CENTER);
        assert(app.contrast_active && actual_contrast == 5 && saved_settings.oled_contrast == 65);
        draw(&c); uint8_t dim[1024]; memcpy(dim,pixels,sizeof(dim));
        input(INPUT_KEY_CENTER,INPUT_TYPE_SHORT); /* duplicated stale short cannot close the page */
        assert(app.contrast_active);
        click(INPUT_KEY_RIGHT); draw(&c);
        assert(actual_contrast == 100 && app.contrast_target == 100);
        for (unsigned y=28; y<42; ++y) for (unsigned x=8; x<120; ++x) {
            unsigned sx=rotated?127-x:x, sy=rotated?63-y:y;
            assert(pixel(x,y)==((dim[(sy/8)*128+sx]>>(sy%8))&1));
        }
        click(INPUT_KEY_LEFT); assert(actual_contrast == 5); draw(&c);
        click(INPUT_KEY_CENTER); assert(!app.contrast_active && actual_contrast == 65); draw(&c);
        input(INPUT_KEY_CENTER,INPUT_TYPE_SHORT); assert(!app.contrast_active);
        click(INPUT_KEY_CENTER); click(INPUT_KEY_RIGHT);
        input(INPUT_KEY_CENTER, INPUT_TYPE_PRESS); input(INPUT_KEY_CENTER, INPUT_TYPE_LONG);
        assert(active == SETTINGS_VIEW_ID_MAIN && actual_contrast == 65 && !app.contrast_active);

        /* Forced view change and settings-app destruction (the sleep/abort path). */
        settings_device_test_open(&app); click(INPUT_KEY_CENTER); click(INPUT_KEY_RIGHT);
        mui_view_dispatcher_switch_to_view(app.p_view_dispatcher,SETTINGS_VIEW_ID_MAIN);
        assert(actual_contrast == 65 && !app.contrast_active);
        settings_device_test_open(&app); click(INPUT_KEY_CENTER); click(INPUT_KEY_RIGHT);
        mini_app_inst_t instance = {&app};
        unsigned saves = save_calls, frees = cleanup_calls;
        app_settings_on_kill(&instance);
        assert(!instance.p_handle && actual_contrast == 65 && save_calls == saves+1 && cleanup_calls > frees);
        settings_device_test_restore(&app); settings_device_test_restore(NULL);
        assert(saved_settings.oled_contrast == 65);
        active = SETTINGS_VIEW_ID_MAIN;
    }
    puts("PASS OLED device test: both languages/rotations, init errors, fixed dim/bright pixels, stale input guard, normal/long/forced exits and sleep/kill restoration");
}
