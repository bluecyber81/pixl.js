{
  "name": "allmiibo-web",
  "version": "3.27.0",
  "description": "Allmiibo Bluetooth-Dateimanager mit ZIP-Sicherung und Übertragungsprüfung",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8010 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765 --strictPort",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:dist": "node --test tests/dist/*.test.mjs",
    "postbuild": "npm run test:dist"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "bytebuffer": "5.0.1",
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.1"
}
