{
  "name": "allmiibo-web",
  "version": "3.49.0",
  "description": "Allmiibo Bluetooth-Dateimanager mit ZIP-Sicherung und Übertragungsprüfung",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8010 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765 --strictPort",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:dist": "node scripts/test-production-build.mjs root",
    "postbuild": "node scripts/copy-license-notices.mjs root && npm run test:dist",
    "build:pages": "vite build --base=/pixl.js/ --outDir=dist-pages",
    "test:dist:pages": "node scripts/test-production-build.mjs pages",
    "postbuild:pages": "node scripts/copy-license-notices.mjs pages && node scripts/legacy-downloads.mjs && npm run test:dist:pages"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "bytebuffer": "5.0.1",
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-i18n": "11.4.19"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.1"
}
